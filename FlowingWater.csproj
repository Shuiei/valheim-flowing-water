<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FlowingWater</AssemblyName>
    <RootNamespace>FlowingWater</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Where the game's and BepInEx's DLLs are: ValheimDir, a Valheim dedicated server's folder, and
         BepInExDir, a BepInEx folder (by default the server's own), given as -p:ValheimDir=... or as
         environment variables. By default the workspace this repo sits in (two folders up). -->
    <ValheimDir Condition="'$(ValheimDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</ValheimDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)/BepInEx</BepInExDir>
    <ManagedDir>$(ValheimDir)/valheim_server_Data/Managed</ManagedDir>
    <!-- Where a Release build copies the dll, when that plugins folder exists. -->
    <PluginsDir Condition="'$(PluginsDir)' == ''">$(BepInExDir)/plugins</PluginsDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(ManagedDir)/SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- The Unity project (unity/), the test and release tools (tools/), the package's files (thunderstore/) and
       their generated files are not part of the plugin. -->
  <ItemGroup>
    <Compile Remove="unity/**" />
    <None Remove="unity/**" />
    <EmbeddedResource Remove="unity/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="tests/**" />
    <None Remove="tools/**" />
    <Compile Remove="thunderstore/**" />
    <None Remove="thunderstore/**" />
  </ItemGroup>
  <!-- The water shader, built by the Unity project in unity/ (see README), one bundle per game platform. -->
  <ItemGroup>
    <EmbeddedResource Include="assets/bundles/flowingwater.windows" LogicalName="FlowingWater.flowingwater.windows" />
    <EmbeddedResource Include="assets/bundles/flowingwater.linux" LogicalName="FlowingWater.flowingwater.linux" />
  </ItemGroup>
  <Target Name="RequireValheimDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')">
    <Error Text="Set ValheimDir to a Valheim dedicated server's folder (-p:ValheimDir=... or an environment variable): the plugin builds against its DLLs. Looked in $(ManagedDir)." />
  </Target>
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/FlowingWater" />
    <Message Importance="high" Text="FlowingWater.dll copied to $(PluginsDir)/FlowingWater" />
  </Target>
</Project>
