    <Compile Include="../../src/Server/ZoneScan.cs" Link="Mod/ZoneScan.cs" />
    <Compile Include="../../src/Server/PrefabPass.cs" Link="Mod/PrefabPass.cs" />
    <Compile Include="../../src/Server/LookWait.cs" Link="Mod/LookWait.cs" />
