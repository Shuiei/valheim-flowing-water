<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mod's files that need no game (and the recorder's), compiled for .NET so that the unit tests
       (FlowingWater.Tests) can run them, in an assembly of their own so that the coverage on main
       (tests/coverage.runsettings) measures them and not the tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>FlowingWater</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FlowingWater.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Server/ErosionRules.cs" Link="Mod/ErosionRules.cs" />
