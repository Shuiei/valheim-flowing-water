<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mod's rules that need no game, tested on .NET: the files are compiled here from the mod (and its
       recorder), since the mod itself only loads in the game. What needs the game (its prefabs, sounds,
       particles) is checked in game with the recorder (tools/Recorder). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test methods need no doc comment: their names say what they check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- As the Valheim world editor's tests: xUnit on Microsoft.Testing.Platform. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Client/SurfaceMath.cs" Link="Mod/SurfaceMath.cs" />
  </ItemGroup>
</Project>
