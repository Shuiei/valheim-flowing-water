<Project Sdk="Microsoft.NET.Sdk">
  <!-- The mod's rules that need no game, tested on .NET: they are compiled from the mod (and its recorder) in
       FlowingWater.Rules, since the mod itself only loads in the game. What needs the game (its prefabs, sounds,
       particles) is checked in game with the recorder (tools/Recorder). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test methods need no doc comment: their names say what they check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- As the Valheim world editor's tests: xUnit on Microsoft.Testing.Platform. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- Code coverage on main (.circleci/continue.yml, tests/coverage.runsettings), as the editor's tests. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FlowingWater.Rules/FlowingWater.Rules.csproj" />
  </ItemGroup>
</Project>
