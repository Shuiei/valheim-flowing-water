// FlowingWater's water near the camera, moved on the graphics card: shallow water over a square of cells around the
// camera, finer than the server's voxels. The server says how much water is where, every second or so; this moves it
// in between as water moves: a surge runs out over the ground and up the walls, a pool sloshes, waves cross and come
// back. Each cell holds a depth over its ground; each face between two cells a speed (a staggered grid). A step:
//   Fluxes      what crosses each face, at the step's start,
//   Momentum    the speeds carried along by the water (Stelling and Duinmeijer, so a front runs as fast as it should),
//               pushed by the difference of the water's levels, slowed by the ground (Manning's friction),
//   Outflow     each cell's share of what it would give that it has,
//   Depth       the water moves through the faces, upwind.
// Once a frame, the water is pulled toward the server's (Reduce, Relax): each voxel column's water toward the server's
// volume there, added or taken where the card's water lies, so the server keeps the say on how much water is where
// while the shape of the water (its slope down a stream, the waves finer than a voxel) stays the card's.
// Along the square's edge, the water is the server's as it is.
// While the card throws falls (its spray on), water running over a lip (the ground beyond well under its own, the water
// beyond too) leaves the sheet into the air (Airborne), which the spray throws as falling water carrying it, and puts
// back where it lands (Landed, with the way it moved), taken in at the next frame's start (LandSpeeds, Land): the water
// landed runs on the way it fell.
// Before it is drawn, the water's surface is shaped (Shape): its level smoothed over the cells round it, so a thin sheet
// lies smooth over the ground's small bumps and fills the hollows between them rather than taking each one's shape.
// Once a frame its foam is carried (CarryFoam), as Crest's foam simulation carries the sea's: the foam of each cell is
// what the current brought there from upstream, fading, plus what was made since: where falling water lands (Churn),
// where water runs into slower water (air trapped: a jump, a fall's foot, a front into a pool), and what the spray's
// foam and bubbles left on the water (FoamAdded); so a fall's foam drifts off downstream as a trail.
// Ripples (RippleBodies, Ripples) are Crest's dynamic waves over the card's water: a height of their own over the water's
// level in each cell, moved by the wave equation and calming, pushed by the bodies in the water (hulls, characters,
// creatures) as they come into a cell's surface or leave it, so a swimmer or a boat leaves rings and a wake.
#pragma kernel Seed
#pragma kernel Fluxes
#pragma kernel Momentum
#pragma kernel Outflow
#pragma kernel Depth
#pragma kernel Reduce
#pragma kernel Relax
#pragma kernel WriteBed
#pragma kernel LandSpeeds
#pragma kernel Land
#pragma kernel Clear
#pragma kernel ShiftCells
#pragma kernel Shape
#pragma kernel CarryFoam
#pragma kernel RippleBodies
#pragma kernel Ripples

// The cells: depth (m), and where a step writes it (each step reads one and writes the other); ground (world height,
// m), the share of its outflow each can give.
RWTexture2D<float> _H;
RWTexture2D<float> _HNext;
RWTexture2D<float> _Bed;
RWTexture2D<float> _Scale;

// Speeds through each cell's east and north faces (m/s), and the step's start's, which Momentum reads to write these;
// what crosses each face then (m times m/s).
RWTexture2D<float> _U;
RWTexture2D<float> _V;
RWTexture2D<float> _UFrom;
RWTexture2D<float> _VFrom;
RWTexture2D<float> _QX;
RWTexture2D<float> _QY;

// Each voxel column's pull: x = the depth of water it lacks (over its area, metres; less than 0 where it has too much),
// y = the card's mean depth there, z = the share of its cells under the server's level.
RWTexture2D<float4> _Pull;

// The server's water, a texel per voxel column: x = its resting top (world height; under -1000 none), y = 1 where the
// card draws it, z = its depth (all its water resting, metres, over the cells with water to stand in), w = faces closed
// by pieces (1 east, 2 north) plus half its foam. Its ledges: where one crosses the column, x = the top of the water at
// its foot (under -1000 none) for the cells whose ground is under y (the rest stand in the water on the ledge).
Texture2D<float4> _Target;
Texture2D<float4> _Layers;

// Water thrown over a lip, by the cell it left (m3, until the spray throws it), and landed by the cell it fell in
// (m3 times LAND_SCALE: added in whole numbers, as each falling drop lands), with its momentum east and north (m3 times
// m/s, times LAND_SCALE); whether water is thrown (0: it runs over the lip into the cell beyond, as any face), and the
// drop that makes a lip (m).
RWTexture2D<float> _Airborne;
RWTexture2D<int> _Landed;
RWTexture2D<int> _LandedX;
RWTexture2D<int> _LandedZ;
int _Throw;
float _LipDrop;

#define LAND_SCALE 1000000.0

// The ground's rows cast this frame: _BedRowCount rows from _BedRow, _N each.
StructuredBuffer<float> _BedRows;
int _BedRow;
int _BedRowCount;

int _N;           // cells along a side
int _PerVoxel;    // cells along a voxel's side
float _Dx;        // a cell's side, m
float _Dt;        // the step, s
float _Gravity;
float _Friction;  // Manning: gravity times roughness squared
float _MaxSpeed;  // the fastest a face may carry in a step (half a cell)
float _MaxDepth;  // the deepest water a face carries as deep (deeper waves would outrun the step)
float _SeaLevel;  // water on ground under it is the sea's
float _Relax;     // a second, how much of the difference to the server's water is made up
float _Drain;     // a second, how much of the water where the server has none goes
int _Border;      // cells along the square's edge that are the server's water as it is

#define DRY_TOP -1000.0
#define WET 0.0001

// Ground at least this high is a wall (not known, or nothing met under it: SimGrid.Wall).
#define WALL 5000.0

bool Inside(int2 c)
{
    return c.x >= 0 && c.y >= 0 && c.x < _N && c.y < _N;
}

int2 Clamped(int2 c)
{
    return clamp(c, int2(0, 0), int2(_N - 1, _N - 1));
}

float4 TargetOf(int2 c)
{
    return _Target[c / _PerVoxel];
}

// The top of the server's water a cell with this ground stands in, in voxel column v: at a ledge's foot, the pool there.
float ServerTop(float bed, int2 v)
{
    float4 ledge = _Layers[v];
    return bed < ledge.y ? ledge.x : _Target[v].x;
}

float Depth(int2 c)
{
    return Inside(c) ? _H[c] : 0.0;
}

float Level(int2 c)
{
    int2 k = Clamped(c);
    return _Bed[k] + _H[k];
}

// The speed through the east face of cell c (0 past the square's edge), as carried from.
float UFrom(int2 c)
{
    return Inside(c) ? _UFrom[c] : 0.0;
}

float VFrom(int2 c)
{
    return Inside(c) ? _VFrom[c] : 0.0;
}

// How high the water stands across the face between cells a and b: from the higher ground to the higher level.
float FlowDepth(int2 a, int2 b)
{
    return max(Level(a), Level(b)) - max(_Bed[Clamped(a)], _Bed[Clamped(b)]);
}

// What crosses the face between cells a (west or south) and b at this speed, before any share is taken: the depth
// upwind, no more than stands across the face.
float FaceFlux(int2 a, int2 b, float speed)
{
    if (speed == 0.0 || !Inside(a) || !Inside(b))
    {
        return 0.0;
    }

    int2 from = speed > 0.0 ? a : b;
    return speed * min(_H[from], max(FlowDepth(a, b), 0.0));
}

// Whether a piece closes the face on this axis (0 east, 1 north) of cell c: only on a voxel's border.
bool Closed(int2 c, int axis)
{
    int along = axis == 0 ? c.x : c.y;
    if ((along + 1) % _PerVoxel != 0)
    {
        return false;
    }

    uint bits = (uint)TargetOf(c).w;
    return (bits & (axis == 0 ? 1u : 2u)) != 0;
}

// The water as the server has it, still.
[numthreads(8, 8, 1)]
void Seed(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float bed = _Bed[c];
    float top = ServerTop(bed, c / _PerVoxel);
    _H[c] = top > DRY_TOP && bed >= _SeaLevel ? max(0.0, top - bed) : 0.0;
    _U[c] = 0.0;
    _V[c] = 0.0;
}

// What crosses each cell's east and north faces at the step's start, metres times metres a second: the speed times
// the depth upwind (no more than stands across the face).
[numthreads(8, 8, 1)]
void Fluxes(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    _QX[c] = FaceFlux(c, c + int2(1, 0), _UFrom[c]);
    _QY[c] = FaceFlux(c, c + int2(0, 1), _VFrom[c]);
}

// The flow through the east (north) face of cell c, as Fluxes found it; 0 past the square's edge.
float QX(int2 c)
{
    return Inside(c) ? _QX[c] : 0.0;
}

float QY(int2 c)
{
    return Inside(c) ? _QY[c] : 0.0;
}

// How the water carries a face's speed along (Stelling and Duinmeijer's scheme, which keeps the momentum where the flow
// widens, as at a front running out onto dry ground: the front keeps the speed of the water behind it). Over the space
// round the face (the halves of the two cells it joins), what comes in through each side brings the speed of the face
// upwind of it; the change is that momentum less the face's own speed times what comes in, over the water there. Along
// the face's own axis (dx = 1, 0 for an east face), the flows through the two cells' middles; across it (dy), the
// flows through the space's sides.
float Carried(int2 c, int2 dx, int2 dy, float speed, float depth)
{
    bool east = dx.x == 1;
    // Through the middles of the cell behind and the cell ahead: the mean of their faces on this axis.
    float behind = 0.5 * ((east ? QX(c - dx) : QY(c - dx)) + (east ? QX(c) : QY(c)));
    float ahead = 0.5 * ((east ? QX(c) : QY(c)) + (east ? QX(c + dx) : QY(c + dx)));
    float behindSpeed = behind > 0.0 ? (east ? UFrom(c - dx) : VFrom(c - dx)) : speed;
    float aheadSpeed = ahead > 0.0 ? speed : (east ? UFrom(c + dx) : VFrom(c + dx));
    float along = (ahead * aheadSpeed) - (behind * behindSpeed) - (speed * (ahead - behind));

    // Through the sides: the two cells' faces across, over and under the space.
    float over = 0.5 * ((east ? QY(c) : QX(c)) + (east ? QY(c + dx) : QX(c + dx)));
    float under = 0.5 * ((east ? QY(c - dy) : QX(c - dy)) + (east ? QY(c + dx - dy) : QX(c + dx - dy)));
    float overSpeed = over > 0.0 ? speed : (east ? UFrom(c + dy) : VFrom(c + dy));
    float underSpeed = under > 0.0 ? (east ? UFrom(c - dy) : VFrom(c - dy)) : speed;
    float across = (over * overSpeed) - (under * underSpeed) - (speed * (over - under));
    return speed - (_Dt * (along + across) / (_Dx * depth));
}

// Whether water running from cell a into cell b falls over a brink: b's ground and its water both under a's ground by
// the lip's drop.
bool Overfall(int2 a, int2 b)
{
    return Inside(a) && Inside(b) && _Bed[b] < _Bed[a] - _LipDrop && Level(b) < _Bed[a] - _LipDrop;
}

// A face's new speed: carried along by the water, pushed from the higher level to the lower, slowed by the ground the
// more the shallower and faster the water is (Manning, by the water's whole speed there); none where no water stands
// across it or a piece closes it. Over a brink, water runs no faster than its waves (sqrt(g h), the critical speed of a
// free overfall): the drop beyond does not pull it on.
float Moved(int2 c, int2 dx, int2 dy, int axis, float speed, float across)
{
    int2 next = c + dx;
    if (!Inside(next) || Closed(c, axis))
    {
        return 0.0;
    }

    float depth = FlowDepth(c, next);
    float mean = 0.5 * (Depth(c) + Depth(next));
    if (depth <= WET || mean <= WET)
    {
        return 0.0;
    }

    speed = Carried(c, dx, dy, speed, mean);
    speed -= _Gravity * _Dt * (Level(next) - Level(c)) / _Dx;
    float flowing = max(depth, 0.005);
    float whole = sqrt((speed * speed) + (across * across));
    speed /= 1.0 + (_Dt * _Friction * whole / (flowing * pow(flowing, 1.0 / 3.0)));
    if (Overfall(c, next) || Overfall(next, c))
    {
        float critical = sqrt(_Gravity * depth);
        speed = clamp(speed, -critical, critical);
    }

    return clamp(speed, -_MaxSpeed, _MaxSpeed);
}

[numthreads(8, 8, 1)]
void Momentum(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float vAtU = 0.25 * (VFrom(c) + VFrom(c + int2(1, 0)) + VFrom(c + int2(0, -1)) + VFrom(c + int2(1, -1)));
    float uAtV = 0.25 * (UFrom(c) + UFrom(c + int2(-1, 0)) + UFrom(c + int2(0, 1)) + UFrom(c + int2(-1, 1)));
    _U[c] = Moved(c, int2(1, 0), int2(0, 1), 0, _UFrom[c], vAtU);
    _V[c] = Moved(c, int2(0, 1), int2(1, 0), 1, _VFrom[c], uAtV);
}

// The share of what a cell would give through its faces this step that it has: the faces carry its depth (upwind),
// so it is the same at any depth.
[numthreads(8, 8, 1)]
void Outflow(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float east = max(0.0, _U[c]);
    float north = max(0.0, _V[c]);
    float west = c.x > 0 ? max(0.0, -_U[c + int2(-1, 0)]) : 0.0;
    float south = c.y > 0 ? max(0.0, -_V[c + int2(0, -1)]) : 0.0;
    float giving = (east + north + west + south) * _Dt / _Dx;
    _Scale[c] = giving > 1.0 ? 1.0 / giving : 1.0;
}

// What crosses the face between cells a (west or south) and b with this speed, metres times metres a second: the depth
// upwind, no more than stands across the face nor than the step can carry, scaled by that cell's share.
float Flux(int2 a, int2 b, float speed)
{
    if (speed == 0.0 || !Inside(a) || !Inside(b))
    {
        return 0.0;
    }

    int2 from = speed > 0.0 ? a : b;
    float depth = min(min(_H[from], max(FlowDepth(a, b), 0.0)), _MaxDepth);
    return speed * depth * _Scale[from];
}

// Whether a cell is in the band along the square's edge (the server's water as it is: none is thrown from there, as the
// spray throws none from the edge).
bool InBorder(int2 c)
{
    return c.x < _Border || c.y < _Border || c.x >= _N - _Border || c.y >= _N - _Border;
}

// Whether water running from cell a into cell b goes over a lip, thrown (while the card throws falls): b's ground and
// its water both under a's ground by the lip's drop, both out of the edge's band, from a column the card draws (where
// the bricks draw the water, they draw its falls).
bool Lip(int2 a, int2 b)
{
    return _Throw != 0 && !InBorder(a) && !InBorder(b) && TargetOf(a).y > 0.5 && Overfall(a, b);
}

// What comes into cell c through the face toward its neighbour n (m2/s; less than 0: goes out): what goes out over a lip
// is thrown (counted in thrown), what comes in over one never comes in.
float Into(int2 c, int2 n, float flowIn, inout float thrown)
{
    if (flowIn > 0.0 && Lip(n, c))
    {
        return 0.0;
    }

    if (flowIn < 0.0 && Lip(c, n))
    {
        thrown -= flowIn;
    }

    return flowIn;
}

[numthreads(8, 8, 1)]
void Depth(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float thrown = 0.0;
    float east = Into(c, c + int2(1, 0), -Flux(c, c + int2(1, 0), _U[c]), thrown);
    float west = Into(c, c + int2(-1, 0), Flux(c + int2(-1, 0), c, c.x > 0 ? _U[c + int2(-1, 0)] : 0.0), thrown);
    float north = Into(c, c + int2(0, 1), -Flux(c, c + int2(0, 1), _V[c]), thrown);
    float south = Into(c, c + int2(0, -1), Flux(c + int2(0, -1), c, c.y > 0 ? _V[c + int2(0, -1)] : 0.0), thrown);
    float h = _H[c] + ((west + east + south + north) * _Dt / _Dx);
    _HNext[c] = _Bed[c] < _SeaLevel ? 0.0 : max(h, 0.0);
    if (thrown > 0.0)
    {
        _Airborne[c] += thrown * _Dt * _Dx;
    }
}

// Each voxel column's pull: the depth of water it lacks against the server's, how deep the card's water is there, and
// how many of its cells lie under the server's level, over the cells with the server's water to stand in (at a ledge's
// foot with no pool, none); where the server has no water, nothing (it drains, Relax).
[numthreads(8, 8, 1)]
void Reduce(uint3 id : SV_DispatchThreadID)
{
    int2 v = (int2)id.xy;
    int columns = _N / _PerVoxel;
    if (v.x >= columns || v.y >= columns)
    {
        return;
    }

    float4 target = _Target[v];
    float depth = 0.0;
    float under = 0.0;
    float cells = 0.0;
    for (int j = 0; j < _PerVoxel; j++)
    {
        for (int i = 0; i < _PerVoxel; i++)
        {
            int2 c = (v * _PerVoxel) + int2(i, j);
            float top = ServerTop(_Bed[c], v);
            if (top > DRY_TOP)
            {
                depth += _H[c];
                under += _Bed[c] < top ? 1.0 : 0.0;
                cells += 1.0;
            }
        }
    }

    if (cells == 0.0)
    {
        _Pull[v] = 0.0;
        return;
    }

    float mean = depth / cells;
    _Pull[v] = float4(target.z - mean, mean, under / cells, 0.0);
}

// The pull at a cell: between the four voxel columns round it, as far as it is from each one's middle, from those the
// server has water in for a cell with its ground (a column with none, or a ledge's with no pool at its foot for a cell
// down there, pulls nothing either way), so the water the server adds or takes comes in smoothly, not a lump to a voxel
// (which, at a strong source, ran down as a ridge a voxel).
float4 PullAt(int2 c, float bed)
{
    int columns = _N / _PerVoxel;
    float2 q = ((float2(c) + 0.5) / _PerVoxel) - 0.5;
    int2 a = (int2)floor(q);
    float2 f = q - a;
    float4 sum = 0.0;
    float weight = 0.0;
    for (int k = 0; k < 4; k++)
    {
        int2 o = int2(k & 1, k >> 1);
        int2 v = clamp(a + o, int2(0, 0), int2(columns - 1, columns - 1));
        float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        if (ServerTop(bed, v) > DRY_TOP && w > 0.0)
        {
            sum += _Pull[v] * w;
            weight += w;
        }
    }

    return weight > 0.0 ? sum / weight : 0.0;
}

[numthreads(8, 8, 1)]
void Relax(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float bed = _Bed[c];
    float top = ServerTop(bed, c / _PerVoxel);
    float h = _H[c];
    bool edge = InBorder(c);
    if (bed < _SeaLevel)
    {
        h = 0.0;
    }
    else if (edge)
    {
        // The server's water as it is along the edge (the water beyond is not moved here). Elsewhere, where the card does
        // not draw it too, it is only pulled toward the server's, as everywhere: a column the server's changes hand from
        // the card to the bricks and back never jumps (the grid joins it to the cells round it, which drew a spike).
        h = top > DRY_TOP ? max(0.0, top - bed) : 0.0;
    }
    else if (top > DRY_TOP)
    {
        // What the column lacks (or has too much of), added where the card's water lies, as deep as it lies there, so
        // its shape is kept; where the card has hardly any yet, spread over the cells under the server's level.
        float4 pull = PullAt(c, bed);
        float change = pull.x * min(1.0, _Relax * _Dt);
        if (pull.y > 0.01)
        {
            h += change * h / pull.y;
        }
        else if (bed < top && pull.z > 0.0)
        {
            h += change / pull.z;
        }

        h = max(0.0, h);
    }
    else
    {
        h -= h * min(1.0, _Drain * _Dt);
        h = h < WET ? 0.0 : h;
    }

    _H[c] = h;
}

// Rows of ground cast on the processor, written in. A cell found a wall holds no water (else drawn at its level, 10 km
// up, and pushed out of it at full speed); a cell whose ground is found where none was known takes the server's water
// there as it is (as Seed), so the water near the camera is whole as soon as its ground is, not filled in by the pull;
// a cell whose ground rose (a piece built in the water) keeps its water's level, the ground taking the water's place.
[numthreads(64, 1, 1)]
void WriteBed(uint3 id : SV_DispatchThreadID)
{
    int x = (int)id.x;
    int r = (int)id.y;
    if (x >= _N || r >= _BedRowCount)
    {
        return;
    }

    int2 c = int2(x, _BedRow + r);
    float was = _Bed[c];
    float bed = _BedRows[(r * _N) + x];
    _Bed[c] = bed;
    if (bed >= WALL)
    {
        _H[c] = 0.0;
    }
    else if (was >= WALL)
    {
        float top = ServerTop(bed, c / _PerVoxel);
        _H[c] = top > DRY_TOP && bed >= _SeaLevel ? max(0.0, top - bed) : 0.0;
    }
    else if (bed > was)
    {
        _H[c] = max(0.0, was + _H[c] - bed);
    }
}

// The depth (m) and momentum (m times m/s) landed in cell c since the last frame; none past the square's edge.
float3 LandedAt(int2 c)
{
    if (!Inside(c))
    {
        return 0.0;
    }

    return float3(_Landed[c], _LandedX[c], _LandedZ[c]) / (LAND_SCALE * _Dx * _Dx);
}

// A face's speed with the water landed either side of it: its momentum added to the face's, over the water then there.
float Landing(float speed, int2 a, int2 b, int axis)
{
    float3 here = LandedAt(a);
    float3 there = LandedAt(b);
    float added = 0.5 * (here.x + there.x);
    if (added <= 0.0 || !Inside(b))
    {
        return speed;
    }

    float depth = 0.5 * (_H[a] + _H[b]);
    float momentum = 0.5 * (axis == 0 ? here.y + there.y : here.z + there.z);
    return clamp(((speed * depth) + momentum) / (depth + added), -_MaxSpeed, _MaxSpeed);
}

// The water landed since the last frame: first the speeds through each cell's east and north faces (Land then adds its
// depth, so these see the water as it was).
[numthreads(8, 8, 1)]
void LandSpeeds(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    _U[c] = Landing(_U[c], c, c + int2(1, 0), 0);
    _V[c] = Landing(_V[c], c, c + int2(0, 1), 1);
}

// Where falling water lands, the pool churns white (FlowingWaterSim.shader): wholly where it lands this fast (metres of
// depth a second), calming over CHURN_CALM seconds once it stops.
RWTexture2D<float> _Churn;
float _Frame;
#define CHURN_FULL 0.05
#define CHURN_CALM 0.8

// The water's foam (0 to 1 of a cell covered), last frame's (_FoamIn) and this one's (_FoamOut); the foam the spray left
// on the water since (FlowingWaterSpray.compute: FOAM_SCALE times a cell's share covered). It fades by _FoamFade a
// second; where the water traps air (FlowingWaterTrapped.cginc, the spray's froth's rule too) it makes as much as
// _FoamTrapped a second, where it traps all it will. Water shallower than FOAM_WATER (m) holds none. Where falling water lands its churn makes foam,
// FOAM_CHURN of a cell at most (lace carried off downstream, not a sheet of white: the churn itself is drawn white).
Texture2D<float> _FoamIn;
RWTexture2D<float> _FoamOut;
RWTexture2D<int> _FoamAdded;
float _FoamFade;
float _FoamTrapped;
#define FOAM_SCALE 1000000.0
#define FOAM_WATER 0.01
#define FOAM_CHURN 0.6

// The water landed since the last frame (_Frame seconds), added to the cells it fell in, which it churns.
[numthreads(8, 8, 1)]
void Land(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float churn = _Churn[c] * exp(-_Frame / CHURN_CALM);
    int landed = _Landed[c];
    if (landed != 0)
    {
        float depth = landed / (LAND_SCALE * _Dx * _Dx);
        _H[c] += depth;
        _Landed[c] = 0;
        _LandedX[c] = 0;
        _LandedZ[c] = 0;
        churn = max(churn, saturate(depth / (max(_Frame, 0.001) * CHURN_FULL)));
    }

    _Churn[c] = churn;
}

// No water in the air, none landed.
[numthreads(8, 8, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    _Airborne[c] = 0.0;
    _Landed[c] = 0;
    _LandedX[c] = 0;
    _LandedZ[c] = 0;
    _FoamAdded[c] = 0;
}

#include "FlowingWaterTrapped.cginc"

// Last frame's foam at a place in cells (a cell's middle at its index plus a half), between the four cells round it;
// none past the square.
float FoamBetween(float2 at)
{
    float2 base = floor(at - 0.5);
    float2 t = at - 0.5 - base;
    int2 b = (int2)base;
    float foam = 0.0;
    for (int k = 0; k < 4; k++)
    {
        int2 o = int2(k & 1, k >> 1);
        int2 n = b + o;
        float w = (o.x == 1 ? t.x : 1.0 - t.x) * (o.y == 1 ? t.y : 1.0 - t.y);
        foam += Inside(n) ? w * _FoamIn[n] : 0.0;
    }

    return foam;
}

// The foam carried over a frame (_Frame seconds): taken from where the current brought it from (semi-Lagrangian, as
// Crest's), faded, with what was made since; none on dry ground, a wall or ground not known.
[numthreads(8, 8, 1)]
void CarryFoam(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float added = _FoamAdded[c] / FOAM_SCALE;
    _FoamAdded[c] = 0;
    float h = _H[c];
    if (h < FOAM_WATER || _Bed[c] >= WALL)
    {
        _FoamOut[c] = 0.0;
        return;
    }

    float2 speed = CellSpeed(c);
    float foam = FoamBetween(float2(c) + 0.5 - (speed * _Frame / _Dx)) * exp(-_FoamFade * _Frame);

    // Air trapped where the water runs into slower water (FlowingWaterTrapped.cginc).
    foam += _FoamTrapped * TrappedAir(c, speed) * _Frame;

    _FoamOut[c] = saturate(max(foam + added, FOAM_CHURN * _Churn[c]));
}

// The ripples: their height over the water's level (m), last step's (_RippleIn) and this one's (_RippleOut), their
// speed up (m/s), and how much of each cell's surface the bodies took last frame (0 to 1). They run as fast as waves on
// water so deep (the root of gravity times its depth), _RippleFastest (m/s) at most, calming over _RippleCalm seconds;
// a body coming into a cell's surface pushes it down at _RipplePush m/s (one leaving lets it up as fast), the water
// round it rising as the push spreads. Water shallower than RIPPLE_WATER (m), a wall or ground not known holds none,
// and they stand RIPPLE_MOST (m) at most over or under the water.
struct Body
{
    float4 centre;
    float4 half;
    float4 axisX;
    float4 axisY;
};

// The bodies (world: the square's south-west corner at _Origin, world x and z).
StructuredBuffer<Body> _Bodies;
int _BodyCount;
float2 _Origin;
Texture2D<float> _RippleIn;
RWTexture2D<float> _RippleOut;
RWTexture2D<float> _RippleSpeed;
RWTexture2D<float> _Occupied;
float _RippleFastest;
float _RippleCalm;
float _RipplePush;
#define RIPPLE_WATER 0.05
#define RIPPLE_MOST 0.3

bool Rippling(int2 c)
{
    return Inside(c) && _H[c] >= RIPPLE_WATER && _Bed[c] < WALL;
}

// How much of the surface round a point a body takes (0 to 1): whether the point is inside it, softened over a cell.
float Taken(Body b, float3 at)
{
    float3 local = at - b.centre.xyz;
    float far;
    if (b.centre.w > 1.5)
    {
        far = length(local) - b.half.x;
    }
    else
    {
        float3 axisZ = cross(b.axisX.xyz, b.axisY.xyz);
        float3 along = abs(float3(dot(local, b.axisX.xyz), dot(local, b.axisY.xyz), dot(local, axisZ))) - b.half.xyz;
        far = max(along.x, max(along.y, along.z));
    }

    return saturate(0.5 - (far / _Dx));
}

// Once a frame: what the bodies took of each cell's surface, and the push of what they took or let go since last frame.
[numthreads(8, 8, 1)]
void RippleBodies(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    if (!Rippling(c))
    {
        _Occupied[c] = 0.0;
        return;
    }

    float3 at = float3(_Origin.x + ((c.x + 0.5) * _Dx), _Bed[c] + _H[c], _Origin.y + ((c.y + 0.5) * _Dx));
    float taken = 0.0;
    for (int b = 0; b < _BodyCount; b++)
    {
        taken = max(taken, Taken(_Bodies[b], at));
    }

    _RippleSpeed[c] -= _RipplePush * (taken - _Occupied[c]);
    _Occupied[c] = taken;
}

// A step of the ripples (_Dt seconds): each cell's speed up pulled by how far it stands from the ripples round it (the
// wave equation; a cell with no water beside it, or past the square, as high as this one: the ripple runs back from it),
// calming, its height moved by its speed (under a body too: what it pushed down there spreads out as the trough of its
// wake, the water it let up behind it as the crest).
[numthreads(8, 8, 1)]
void Ripples(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    if (!Rippling(c))
    {
        _RippleOut[c] = 0.0;
        _RippleSpeed[c] = 0.0;
        return;
    }

    float here = _RippleIn[c];
    int2 around[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
    float pull = 0.0;
    for (int s = 0; s < 4; s++)
    {
        int2 n = c + around[s];
        pull += (Rippling(n) ? _RippleIn[n] : here) - here;
    }

    float fastest = min(_Gravity * _H[c], _RippleFastest * _RippleFastest);
    float calm = exp(-_Dt / _RippleCalm);
    float speed = (_RippleSpeed[c] + (fastest * pull / (_Dx * _Dx) * _Dt)) * calm;
    float height = (here + (speed * _Dt)) * calm;
    _RippleSpeed[c] = speed;
    _RippleOut[c] = clamp(height, -RIPPLE_MOST, RIPPLE_MOST);
}

// A texture of cells as the square moved by _Shift cells sees it (the camera went on): each cell takes the one at its
// place plus the move; those past the old square's edge take _Outside.
RWTexture2D<float> _ShiftFrom;
RWTexture2D<float> _ShiftTo;
int2 _Shift;
float _Outside;

[numthreads(8, 8, 1)]
void ShiftCells(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    int2 from = c + _Shift;
    _ShiftTo[c] = Inside(from) ? _ShiftFrom[from] : _Outside;
}

// The water as it is drawn (FlowingWaterSim.shader), as a depth over each cell's ground: its level smoothed over the
// cells round it (3 by 3, the nearer counting more; only the water within SHAPE_JOIN of it, not across a ledge or a
// fall, nor ground not known), so a thin sheet lies smooth over the ground's small bumps instead of taking the shape of
// each; never thinner than the water there. Inside the sheet (water on two opposite sides of the cell, not its edge), a
// wet cell is drawn SHAPE_THIN deep at least, and a dry one (a bump) covered where that level is over its ground,
// SHAPE_FILL deep at most. Only the look: the water moved is not changed.
#define SHAPE_WET 0.005
#define SHAPE_JOIN 0.15
#define SHAPE_THIN 0.015
#define SHAPE_FILL 0.1

RWTexture2D<float> _Drawn;

[numthreads(8, 8, 1)]
void Shape(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float bed = _Bed[c];
    float depth = _H[c];
    bool wet = depth > SHAPE_WET;
    if (bed >= WALL)
    {
        _Drawn[c] = depth;
        return;
    }

    float reference = bed + (wet ? depth : 0.0);
    float sum = 0.0;
    float weight = 0.0;
    uint around = 0u;
    for (int dz = -1; dz <= 1; dz++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 n = c + int2(dx, dz);
            if (!Inside(n) || _H[n] <= SHAPE_WET || _Bed[n] >= WALL)
            {
                continue;
            }

            float level = _Bed[n] + _H[n];
            if (abs(level - reference) > SHAPE_JOIN)
            {
                continue;
            }

            float w = (dx == 0 ? 2.0 : 1.0) * (dz == 0 ? 2.0 : 1.0);
            sum += w * level;
            weight += w;
            around |= 1u << (uint)(((dz + 1) * 3) + dx + 1);
        }
    }

    if (weight <= 0.0)
    {
        _Drawn[c] = depth;
        return;
    }

    // The bits of the cells round it: 0 south-west, 1 south, 2 south-east, 3 west, 5 east, 6 north-west, 7 north,
    // 8 north-east.
    float smooth = sum / weight;
    bool inside = ((around & 0x28u) == 0x28u) || ((around & 0x82u) == 0x82u) || ((around & 0x101u) == 0x101u) || ((around & 0x44u) == 0x44u);
    if (wet)
    {
        _Drawn[c] = max(max(smooth - bed, depth), inside ? SHAPE_THIN : 0.0);
        return;
    }

    _Drawn[c] = max(inside ? clamp(smooth - bed, 0.0, SHAPE_FILL) : 0.0, depth);
}
