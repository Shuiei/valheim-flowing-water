// FlowingWater's falls, splashes and spray near the camera, on the graphics card: particles thrown from the water the
// card moves (FlowingWaterSim.compute), only for the look (nothing of them is sent, nor is any water taken from the
// sheet for them). A ring of particles: each new one takes the next place, the oldest giving way.
//   EmitFromWater  per cell: fast water throws droplets (rapids); the water the card threw over a lip (where the
//                  ground beside falls away) leaves as sheets of water at the water's own speed, which fall and arc,
//                  carrying it; where the server's water falls through the air (a fall the card draws), sheets fall from
//                  its top (carrying none: the server's pool under it is the card's already).
//   Move           per particle: thrown and falling, slowed by the air; one meeting the water's surface or the ground
//                  ends there, adding the water it carries there, a sheet that lands fast throwing up a splash; one
//                  past the square, or over ground not known, fades out where it is.
//   Curtains       per cell: each face the card's water runs out of over a lip, with the arc its water falls along
//                  down to where it lands, listed for FlowingWaterFall.shader to draw as one curtain of water from the
//                  lip to the pool (the sheets carrying the water are drawn faint: its mist).
//   CrowdClear     per hashed cell: empties the crowd count (below) before Move counts the particles again.
// With _Froth on, the droplets are sorted as Ihmsen, Akinci, Akinci and Teschner's diffuse particles (2012) are, by where
// they are against the card's water each step: over its surface spray, falling; at its surface foam, riding it with the
// current until it fades; under it a bubble, rising with the water to foam. Water slamming into slower water (a jump, a
// fall's foot, a front into a pool) traps air: it lets bubbles and foam go, the more the harder and faster; a sheet
// plunging into a pool drives bubbles down under its splash. Spray in a crowd (many in the same half metre) is drawn as
// mist, wide and faint, not as so many bright droplets (FlowingWaterSpray.shader reads the crowd count).
#pragma kernel EmitFromWater
#pragma kernel Move
#pragma kernel Curtains
#pragma kernel CrowdClear

// A particle: its place and age (s), its velocity (m/s) and how long it lives (s), its size (m), kind and the water it
// carries (m3).
struct Particle
{
    float4 placeAge;
    float4 velocityLife;
    float4 sizeKind;
};

#define DROPLET 0.0
#define SHEET 1.0
#define SPLASH 2.0
#define FOAM 3.0
#define BUBBLE 4.0

// Three rings: the first _Carriers places for the sheets carrying the card's water (never given to anything else, so none
// is lost to a droplet), the last _FrothRoom for the froth thrown as foam or bubbles (a fall's plunge or trapped air
// making much of it gives way only to its own older froth, never to spray, splashes or falling sheets), the rest for
// everything else; the next place to fill in each (spray, carriers, froth), counted on (taken modulo its ring).
RWStructuredBuffer<Particle> _Particles;
RWStructuredBuffer<uint> _Next;
uint _Count;
uint _Carriers;
uint _FrothRoom;

// The water the card moves (its textures, a cell each), the square's south-west corner (world x, z) and cells.
Texture2D<float> _H;
Texture2D<float> _Bed;
Texture2D<float> _U;
Texture2D<float> _V;
int _N;
float _Dx;
float2 _Origin;

// The server's water's falls, a texel per voxel column (FlowingWaterSim.compute's _Layers): z = the top of water
// falling through the air over it (under -1000 none); cells along a voxel's side.
Texture2D<float4> _Layers;
int _PerVoxel;

// Falls: so many sheets a second for each square metre a fall covers.
float _FallRate;

float _Dt;
float _Gravity;
uint _Seed;

// Rapids: water at least this deep (m) and faster than this (m/s) throws droplets, so many a second for each m/s more
// over each square metre (a thin sheet running fast down a slope throws none: it does not break up into spray).
float _SprayDepth;
float _SprayFrom;
float _SprayRate;

// Lips: ground this much lower than the ground beside it (the water's) is a fall; the water thrown over one, by the cell
// it left (the card's: FlowingWaterSim.compute's), a sheet for each so much of it (m3); the water landed, by the cell
// (m3 times LAND_SCALE), with its momentum east and north (m3 times m/s, times LAND_SCALE).
float _LipDrop;
float _SheetVolume;
RWTexture2D<float> _Airborne;
RWTexture2D<int> _Landed;
RWTexture2D<int> _LandedX;
RWTexture2D<int> _LandedZ;

#define LAND_SCALE 1000000.0
#define MOST_SHEETS 8u

// A sheet of falling water is at least this wide each way (m): wide enough that those of a fall overlap into one curtain
// (thinner, each was seen apart, an icicle).
#define FALL_SIZE 0.12

// A particle over ground not known, or past the square, fades out over this long there (s), and ends once it has been
// there so long: not gone at once in mid-air (crossing a cell of a wall, or rows not cast yet), nor falling on through
// the ground. Its time there is kept in sizeKind.w (FlowingWaterSpray.shader fades it by it); back over ground known,
// it comes back as fast.
#define UNKNOWN_LIFE 0.25

// Splashes: a sheet landing faster than this throws up so many droplets.
float _SplashFrom;
uint _SplashDroplets;

// The froth (1: the droplets sorted into spray, foam and bubbles, and air trapped by the water; 0: droplets end where
// they land, as before). Trapped air: so many froth particles a second over each square metre at the most, water
// meeting the water beside it this much faster than it (m/s, summed over its four sides) trapping none, from the
// second all it will; water slower than _FrothSlow (m/s) traps none, all it will from _FrothFast. A sheet landing
// faster than _SplashFrom in water deeper than PLUNGE_WATER drives so many bubbles down.
uint _Froth;
float _TrappedRate;
float _TrappedFrom;
float _TrappedFull;
float _FrothSlow;
float _FrothFast;
uint _PlungeBubbles;

// Two counts in hashed cells CROWD_SIZE metres a side (CROWD_CELLS of them), each step by Move: the spray (droplets and
// splashes: FlowingWaterSpray.shader draws spray in a crowd as mist) and, apart, the froth (foam and bubbles: a cell
// holding FOAM_FULL of it is full, no more foam forms there nor bubbles go down into it, and its water traps no more
// air; froth covers the water, it does not pile up). Apart, so the splashes thick at a fall's foot never fill a cell
// that foam is to cover.
RWStructuredBuffer<uint> _Crowd;
RWStructuredBuffer<uint> _FrothCrowd;
#define CROWD_CELLS 65536u
#define CROWD_SIZE 0.5
#define FOAM_FULL 8u

// Foam rides water at least FOAM_WATER deep (m), within FOAM_BAND of its top (m: lower down, it is a bubble), a drop in
// the air once the top falls away more than FOAM_DROP under it (m: a lip); spray landing on the water is foam from there one time in FOAM_SHARE (the rest is lost in it).
// Foam lives FOAM_LIFE to twice that (s) and is a patch FOAM_SIZE to twice that across (m, half of it each way); a
// bubble rises BUOYANCY m/s² faster, BUBBLE_RISE m/s at most, and is born BUBBLE_SIZE to twice that (m).
#define FOAM_WATER 0.02
#define FOAM_BAND 0.03
#define FOAM_DROP 0.25
#define FOAM_SHARE 0.4
#define FOAM_LIFE 1.5
#define FOAM_SIZE 0.06
#define BUOYANCY 4.0
#define BUBBLE_RISE 1.0
#define BUBBLE_SIZE 0.006
#define BUBBLE_LIFE 4.0
#define PLUNGE_WATER 0.15

// A random number in [0, 1) from a seed, which it moves on (PCG hash).
float Random(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return word / 4294967296.0;
}

bool Inside(int2 c)
{
    return c.x >= 0 && c.y >= 0 && c.x < _N && c.y < _N;
}

// The water's velocity along the ground at a cell's middle (m/s, east and north): its faces' speeds averaged.
float2 SpeedAt(int2 c)
{
    int2 west = max(c - int2(1, 0), 0);
    int2 south = max(c - int2(0, 1), 0);
    return float2(0.5 * (_U[c] + _U[west]), 0.5 * (_V[c] + _V[south]));
}

// The crowd cell a place counts in.
uint CrowdIndex(float3 place)
{
    int3 k = (int3)floor(place / CROWD_SIZE);
    return ((uint)(k.x * 73856093) ^ (uint)(k.y * 19349663) ^ (uint)(k.z * 83492791)) % CROWD_CELLS;
}

// The water a particle carries (m3) added where it is, with the way it moves along the ground (it runs on so): on the
// card's water or ground under it, inside the square (over ground not known, or past the square, it is lost to the card;
// the server's water pulls the card's back to it).
void Land(float3 place, float3 velocity, float water)
{
    int2 c = (int2)floor((place.xz - _Origin) / _Dx);
    if (water > 0.0 && Inside(c) && _Bed[c] < 5000.0)
    {
        InterlockedAdd(_Landed[c], (int)(water * LAND_SCALE + 0.5));
        InterlockedAdd(_LandedX[c], (int)round(water * velocity.x * LAND_SCALE));
        InterlockedAdd(_LandedZ[c], (int)round(water * velocity.z * LAND_SCALE));
    }
}

// A new particle, in its ring's next place: a carrier still in the air there lands its water where it is first.
void Add(float3 place, float3 velocity, float life, float size, float kind, float water)
{
    uint at;
    if (water > 0.0)
    {
        InterlockedAdd(_Next[1], 1u, at);
        at %= _Carriers;
        Particle old = _Particles[at];
        if (old.placeAge.w < old.velocityLife.w)
        {
            Land(old.placeAge.xyz, old.velocityLife.xyz, old.sizeKind.z);
        }
    }
    else if (kind == FOAM || kind == BUBBLE)
    {
        InterlockedAdd(_Next[2], 1u, at);
        at = _Count - _FrothRoom + (at % _FrothRoom);
    }
    else
    {
        InterlockedAdd(_Next[0], 1u, at);
        at = _Carriers + (at % (_Count - _Carriers - _FrothRoom));
    }

    Particle p;
    p.placeAge = float4(place, 0.0);
    p.velocityLife = float4(velocity, life);
    p.sizeKind = float4(size, kind, water, 0.0);
    _Particles[at] = p;
}

// How many of something expected this step: its whole part, and one more as often as its fraction.
uint Count(float expected, inout uint state)
{
    return (uint)floor(expected + Random(state));
}

[numthreads(8, 8, 1)]
void EmitFromWater(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c) || c.x == 0 || c.y == 0 || c.x == _N - 1 || c.y == _N - 1)
    {
        return;
    }

    uint state = (uint)(c.x * 73856093) ^ (uint)(c.y * 19349663) ^ (_Seed * 83492791u);

    // A fall: sheets from its top down through the air, a little apart, over the cells whose ground is under it.
    float fallTop = _Layers[c / _PerVoxel].z;
    if (fallTop > -1000.0 && _Bed[c] + _H[c] < fallTop)
    {
        uint n = min(Count(_FallRate * _Dx * _Dx * _Dt, state), 3u);
        for (uint k = 0; k < n; k++)
        {
            float3 place = float3(_Origin.x + ((c.x + Random(state)) * _Dx), fallTop - (0.3 * Random(state)), _Origin.y + ((c.y + Random(state)) * _Dx));
            float3 velocity = float3(Random(state) - 0.5, -0.5 - Random(state), Random(state) - 0.5) * 0.6;
            Add(place, velocity, 4.0, FALL_SIZE + (FALL_SIZE * Random(state)), SHEET, 0.0);
        }
    }

    float h = _H[c];
    float bed = _Bed[c];
    float level = bed + h;
    float2 speed = float2(0.5 * (_U[c] + _U[c - int2(1, 0)]), 0.5 * (_V[c] + _V[c - int2(0, 1)]));
    float3 centre = float3(_Origin.x + ((c.x + 0.5) * _Dx), level, _Origin.y + ((c.y + 0.5) * _Dx));

    // Lips: the water thrown over them, once there is a sheet's worth, leaves as sheets carrying it all (as few as that
    // takes), through the faces it leaves by as each carries, where the ground beyond falls away; at its speed, from
    // just past the face, at the water's top and under it.
    float thrown = _Airborne[c];
    if (thrown >= _SheetVolume)
    {
        // The faces over a lip as the card's water throws it (the ground and the water beyond well under this ground),
        // each as much more often as more leaves by it now; the speed out through each.
        int2 sides[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
        float weights[4];
        float brinks[4];
        float total = 0.0;
        for (int s = 0; s < 4; s++)
        {
            int2 next = c + sides[s];
            float leaving = s == 0 ? _U[c] : s == 1 ? -_U[c - int2(1, 0)] : s == 2 ? _V[c] : -_V[c - int2(0, 1)];
            bool lip = _Bed[next] < bed - _LipDrop && _Bed[next] + _H[next] < bed - _LipDrop;
            brinks[s] = max(leaving, 0.0);
            weights[s] = lip ? brinks[s] + 0.05 : 0.0;
            total += weights[s];
        }

        uint n = min((uint)(thrown / _SheetVolume), MOST_SHEETS);
        float carried = n == MOST_SHEETS ? thrown : n * _SheetVolume;
        for (uint k = 0; k < n; k++)
        {
            // The face it leaves by (none, if no face is over a lip now: it drops where it is, with the current).
            float pick = Random(state) * total;
            int side = -1;
            for (int t = 0; t < 4 && total > 0.0; t++)
            {
                pick -= weights[t];
                side = side < 0 && pick <= 0.0 ? t : side;
            }

            float2 along = side >= 0 ? float2(sides[side]) : 0.0;
            float2 across = side >= 0 ? float2(-along.y, along.x) : float2(1.0, 0.0);
            float3 place = centre + (float3(along.x, 0.0, along.y) * (0.55 * _Dx)) + (float3(across.x, 0.0, across.y) * ((Random(state) - 0.5) * _Dx)) - float3(0.0, Random(state) * h, 0.0);

            // Out through the face as fast as the water goes over it (the brink's speed), along it as fast as it runs.
            float2 flat = side >= 0 ? (along * (brinks[side] + (0.2 * Random(state)))) + (across * dot(speed, across)) : speed;
            float3 velocity = float3(flat.x, 0.0, flat.y);
            Add(place, velocity, 6.0, FALL_SIZE + (0.1 * min(h, 1.0)) + (0.5 * FALL_SIZE * Random(state)), SHEET, carried / n);
        }

        _Airborne[c] = thrown - carried;
    }

    // Rapids: fine droplets off the surface, along the current, a little up into the air (most fall back within a
    // few tens of centimetres, as real spray off running water).
    float fast = length(speed);
    if (h >= _SprayDepth && fast > _SprayFrom)
    {
        uint n = min(Count(_SprayRate * (fast - _SprayFrom) * _Dx * _Dx * _Dt, state), 2u);
        for (uint k = 0; k < n; k++)
        {
            float3 jitter = float3(Random(state) - 0.5, 0.0, Random(state) - 0.5) * _Dx;
            // Up at 0.5 to 1.5 m/s, the faster the water the more of that span.
            float up = 0.5 + (Random(state) * min(1.0, 0.4 + (0.1 * fast)));
            float3 velocity = float3(speed.x * 0.9, up, speed.y * 0.9) + (float3(Random(state) - 0.5, 0.0, Random(state) - 0.5) * 0.6);
            Add(centre + jitter, velocity, 0.3 + (0.4 * Random(state)), 0.004 + (0.008 * Random(state)), DROPLET, 0.0);
        }
    }

    // Trapped air: water running into slower water beside it (how much faster it comes on toward each side than the
    // water there goes, summed) lets froth go in its water, the more the faster it runs; bubbles at a depth in it, foam
    // at its top, going as it goes. None where the surface's crowd cell is full of foam.
    if (_Froth > 0u && h >= FOAM_WATER * 2.0 && fast > _FrothSlow && _FrothCrowd[CrowdIndex(centre)] < FOAM_FULL)
    {
        int2 around[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
        float trapped = 0.0;
        for (int s = 0; s < 4; s++)
        {
            int2 side = around[s];
            int2 next = c + side;
            if (_H[next] >= FOAM_WATER)
            {
                trapped += max(dot(speed - SpeedAt(next), float2(side)), 0.0);
            }
        }

        float potential = saturate((trapped - _TrappedFrom) / (_TrappedFull - _TrappedFrom));
        float energy = saturate(((fast * fast) - (_FrothSlow * _FrothSlow)) / ((_FrothFast * _FrothFast) - (_FrothSlow * _FrothSlow)));
        uint n = min(Count(_TrappedRate * potential * energy * _Dx * _Dx * _Dt, state), 2u);
        for (uint k = 0; k < n; k++)
        {
            float depth = Random(state) * min(h, 0.4);
            float3 place = centre + float3((Random(state) - 0.5) * _Dx, -depth, (Random(state) - 0.5) * _Dx);
            float3 velocity = float3(speed.x, 0.0, speed.y) + (float3(Random(state) - 0.5, 0.0, Random(state) - 0.5) * 0.4);
            bool foam = depth < FOAM_BAND;
            float life = foam ? FOAM_LIFE * (1.0 + Random(state)) : BUBBLE_LIFE;
            float size = foam ? FOAM_SIZE * (1.0 + Random(state)) : BUBBLE_SIZE * (1.0 + Random(state));
            Add(place, velocity, life, size, foam ? FOAM : BUBBLE, 0.0);
        }
    }
}

// Foam from here at this place, a patch FOAM_SIZE to twice that across, counted in its crowd cell: its life's end,
// FOAM_LIFE to twice that from this age; or, where its crowd cell holds FOAM_FULL already, this age (it is lost in the
// foam there: foam covers the water, it does not pile up).
float ToFoam(inout Particle p, float3 place, float age, inout uint state)
{
    uint before;
    InterlockedAdd(_FrothCrowd[CrowdIndex(place)], 1u, before);
    p.sizeKind.x = FOAM_SIZE * (1.0 + Random(state));
    return before >= FOAM_FULL ? age : age + (FOAM_LIFE * (1.0 + Random(state)));
}

[numthreads(64, 1, 1)]
void Move(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count)
    {
        return;
    }

    Particle p = _Particles[id.x];
    float age = p.placeAge.w;
    float life = p.velocityLife.w;
    if (age >= life)
    {
        return;
    }

    uint state = id.x * 9781u + _Seed * 6271u;
    float kind = p.sizeKind.y;
    float3 place = p.placeAge.xyz;
    float3 velocity = p.velocityLife.xyz;
    int2 c = (int2)floor((place.xz - _Origin) / _Dx);
    bool known = Inside(c) && _Bed[c] < 5000.0;

    // A bubble whose water is gone (drained, or the square moved) is gone; foam and bubbles still going when the froth is
    // turned off end (no bubble rises to foam then).
    if ((kind == BUBBLE && known && _H[c] < FOAM_WATER) || (_Froth == 0u && (kind == FOAM || kind == BUBBLE)))
    {
        p.placeAge.w = life;
        _Particles[id.x] = p;
        return;
    }

    if (kind == FOAM)
    {
        // Along the water's top with its current, held to the top where it goes (fading out once it is dry there);
        // over a drop (a lip, a fall), a drop in the air from here, going on as the water went, and falling.
        float2 flow = known ? SpeedAt(c) : velocity.xz;
        velocity = float3(flow.x, 0.0, flow.y);
        place += velocity * _Dt;
        int2 to = (int2)floor((place.xz - _Origin) / _Dx);
        if (Inside(to) && _Bed[to] < 5000.0)
        {
            float top = _Bed[to] + _H[to];
            if (top < place.y - FOAM_DROP)
            {
                kind = DROPLET;
                p.sizeKind.x = min(p.sizeKind.x * 0.15, 0.012);
            }
            else
            {
                place.y = top;
                life = _H[to] < FOAM_WATER ? min(life, age + 0.15) : life;
            }
        }
    }
    else if (kind == BUBBLE)
    {
        // Carried with the water, rising through it: foam once it is up.
        float2 flow = known ? SpeedAt(c) : velocity.xz;
        velocity = lerp(velocity, float3(flow.x, 0.0, flow.y), saturate(4.0 * _Dt));
        velocity.y = min(velocity.y + (BUOYANCY * _Dt), BUBBLE_RISE);
        place += velocity * _Dt;
    }
    else
    {
        velocity.y -= _Gravity * _Dt;
        velocity /= 1.0 + (_Dt * (kind == SHEET ? 0.15 : 1.2));
        place += velocity * _Dt;
    }

    age += _Dt;
    bool counted = false;

    // Met the water's surface or the ground, inside the square: it ends; a sheet landing fast throws up a splash. Past
    // the square, or over ground not known, nothing says where it lands: it fades out, ending after UNKNOWN_LIFE there
    // (else it fell on through the ground for the rest of its life, ever faster); one that comes over ground known
    // first lives on, landing there.
    c = (int2)floor((place.xz - _Origin) / _Dx);
    if (!Inside(c) || _Bed[c] >= 5000.0)
    {
        p.sizeKind.w += _Dt;
        age = p.sizeKind.w >= UNKNOWN_LIFE ? life : age;
    }
    else
    {
        p.sizeKind.w = max(0.0, p.sizeKind.w - _Dt);
        float bed = _Bed[c];
        float h = _H[c];
        if (kind == BUBBLE)
        {
            // Never into the ground; up at the top, it is foam.
            place.y = max(place.y, bed + 0.02);
            if (place.y >= bed + h - FOAM_BAND)
            {
                place.y = bed + h;
                life = ToFoam(p, place, age, state);
                counted = true;
                kind = FOAM;
                velocity.y = 0.0;
            }
        }
        else if (kind != FOAM && place.y <= bed + h)
        {
            Land(place, velocity, p.sizeKind.z);
            p.sizeKind.z = 0.0;

            if (kind == SHEET && -velocity.y > _SplashFrom)
            {
                float strength = min(-velocity.y, 12.0);
                for (uint k = 0; k < _SplashDroplets; k++)
                {
                    float angle = 6.2831853 * Random(state);
                    float outward = (0.3 + Random(state)) * 0.25 * strength;
                    float3 kick = float3(cos(angle) * outward, (0.3 + (0.5 * Random(state))) * 0.45 * strength, sin(angle) * outward);
                    Add(float3(place.x, bed + h, place.z), kick + (0.3 * float3(velocity.x, 0.0, velocity.z)), 0.3 + (0.5 * Random(state)), 0.008 + (0.015 * Random(state)), SPLASH, 0.0);
                }

                // Plunging into a pool, it drives air down with it: bubbles under its splash, as deep as it came fast
                // (in its own cell: the water beside, at a fall's foot, can stand far lower), each taking its place in
                // its crowd cell first (counting those already made this step): none where FOAM_FULL are already.
                if (_Froth > 0u && h >= PLUNGE_WATER)
                {
                    float deep = min(h - FOAM_BAND, min(0.12 * strength, 1.0));
                    float2 corner = _Origin + (float2(c) * _Dx);
                    for (uint b = 0; b < _PlungeBubbles; b++)
                    {
                        float3 at = float3(corner.x + ((0.05 + (0.9 * Random(state))) * _Dx), bed + h - FOAM_BAND - (Random(state) * deep), corner.y + ((0.05 + (0.9 * Random(state))) * _Dx));
                        float3 down = (0.2 * velocity) + (float3(Random(state) - 0.5, 0.0, Random(state) - 0.5) * 0.5);
                        float size = BUBBLE_SIZE * (1.0 + Random(state));
                        uint before;
                        InterlockedAdd(_FrothCrowd[CrowdIndex(at)], 1u, before);
                        if (before < FOAM_FULL)
                        {
                            Add(at, down, BUBBLE_LIFE, size, BUBBLE, 0.0);
                        }
                    }
                }
            }

            // Spray down on the water is foam from here, some of it; elsewhere it ends.
            if (_Froth > 0u && kind != SHEET && h >= FOAM_WATER && Random(state) < FOAM_SHARE)
            {
                place.y = bed + h;
                life = ToFoam(p, place, age, state);
                counted = true;
                kind = FOAM;
                velocity = 0.0;
            }
            else
            {
                age = life;
            }
        }
    }

    // At its life's end in the air, a carrier lands its water where it is.
    if (age >= life && p.sizeKind.z > 0.0)
    {
        Land(place, velocity, p.sizeKind.z);
        p.sizeKind.z = 0.0;
    }

    // Spray and froth still going count in their crowd cells, each its own (sheets do not: a fall is its curtain, no
    // crowd of spray).
    if (_Froth > 0u && age < life && kind != SHEET && !counted)
    {
        uint cell = CrowdIndex(place);
        if (kind == FOAM || kind == BUBBLE)
        {
            InterlockedAdd(_FrothCrowd[cell], 1u);
        }
        else
        {
            InterlockedAdd(_Crowd[cell], 1u);
        }
    }

    p.sizeKind.y = kind;
    p.placeAge = float4(place, age);
    p.velocityLife = float4(velocity, life);
    _Particles[id.x] = p;
}

[numthreads(64, 1, 1)]
void CrowdClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < CROWD_CELLS)
    {
        _Crowd[id.x] = 0u;
        _FrothCrowd[id.x] = 0u;
    }
}

// A curtain: a face of a cell its water runs out of over a lip, drawn by FlowingWaterFall.shader as a strip from the
// cell's centre over to the face, then falling from the water's top there along the arc it is thrown on. start: the
// face's middle at the water's top (world), and how long the water falls from there till it lands (s); velocity: how
// fast it leaves (m/s, along the ground: as fast as over a brink, sqrt(g h), at least), and how much runs out (m2/s:
// depth times speed); across: along the lip (x, z), the strip's width (m), and whether its two ends are open
// (no curtain beside: 1 the end to the left, 2 the right one); ends: the water's depth there (m), whether it lands (1)
// or runs out of the square or over ground not known (0), and how fast each of its sides moves out as it falls (m/s: a
// jet fanning out, JetArcs).
struct Curtain
{
    float4 start;
    float4 velocity;
    float4 across;
    float4 ends;
};

// The curtains this frame, counted by the buffer's counter (those past _MostCurtains are not kept: SprayParticles draws
// that many at most).
RWStructuredBuffer<Curtain> _Curtains;
uint _MostCurtains;

// The columns the card draws (FlowingWaterSim.compute's _Target: y over 0.5), and the cells along the square's edge
// whose water is the server's as it is: where the bricks draw the water, they draw its falls.
Texture2D<float4> _Target;
int _Border;

// The arc is followed in steps this long (s), for this long at most.
#define CURTAIN_STEP 0.03
#define CURTAIN_LONGEST 3.0

// Thinner water than this (m) throws no curtain.
#define CURTAIN_WATER 0.005

bool InBorder(int2 c)
{
    return c.x < _Border || c.y < _Border || c.x >= _N - _Border || c.y >= _N - _Border;
}

// Whether the water of cell c runs over a lip through its face toward side, as the card's water throws it
// (FlowingWaterSim.compute's Lip: neither cell in the edge's band, from a column the card draws), and how fast it
// leaves by it.
bool OverLip(int2 c, int2 side, out float leaving)
{
    leaving = 0.0;
    int2 next = c + side;
    if (!Inside(c) || !Inside(next) || InBorder(c) || InBorder(next) || _Target[c / _PerVoxel].y <= 0.5)
    {
        return false;
    }

    leaving = side.x > 0 ? _U[c] : side.x < 0 ? -_U[c - int2(1, 0)] : side.y > 0 ? _V[c] : -_V[c - int2(0, 1)];
    float bed = _Bed[c];
    return leaving > 0.0 && _H[c] > CURTAIN_WATER && _Bed[next] < bed - _LipDrop && _Bed[next] + _H[next] < bed - _LipDrop;
}

[numthreads(8, 8, 1)]
void Curtains(uint3 id : SV_DispatchThreadID)
{
    int2 c = (int2)id.xy;
    if (!Inside(c))
    {
        return;
    }

    float h = _H[c];
    float level = _Bed[c] + h;
    float3 centre = float3(_Origin.x + ((c.x + 0.5) * _Dx), level, _Origin.y + ((c.y + 0.5) * _Dx));
    float brink = max(sqrt(_Gravity * h), 0.3);
    int2 sides[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
    for (int s = 0; s < 4; s++)
    {
        float leaving;
        if (!OverLip(c, sides[s], leaving))
        {
            continue;
        }

        float2 along = float2(sides[s]);
        float2 across = float2(-along.y, along.x);
        float2 run = along * max(leaving, brink);
        float3 face = centre + (float3(along.x, 0.0, along.y) * (0.5 * _Dx));

        // Along the arc till it meets the water's top or the ground; past the square or over ground not known, it ends
        // there, open.
        float t = 0.0;
        float lands = 0.0;
        while (t < CURTAIN_LONGEST)
        {
            float next = t + CURTAIN_STEP;
            float3 at = face + float3(run.x * next, -0.5 * _Gravity * next * next, run.y * next);
            int2 under = (int2)floor((at.xz - _Origin) / _Dx);
            if (!Inside(under) || _Bed[under] >= 5000.0)
            {
                break;
            }

            float top = _Bed[under] + _H[under];
            if (at.y <= top)
            {
                // Where between the two steps it met the top.
                float before = face.y - (0.5 * _Gravity * t * t);
                t += CURTAIN_STEP * saturate((before - top) / max(before - at.y, 1e-4));
                lands = 1.0;
                break;
            }

            t = next;
        }

        // Its ends: open where the cell beside along the lip throws no curtain through the same face.
        float unused;
        int2 left = c + int2(across);
        int2 right = c - int2(across);
        float open = (OverLip(left, sides[s], unused) ? 0.0 : 1.0) + (OverLip(right, sides[s], unused) ? 0.0 : 2.0);

        Curtain curtain;
        curtain.start = float4(face, t);
        curtain.velocity = float4(run.x, 0.0, run.y, h * leaving);
        curtain.across = float4(across, _Dx, open);
        curtain.ends = float4(h, lands, 0.0, 0.0);
        uint at = _Curtains.IncrementCounter();
        if (at < _MostCurtains)
        {
            _Curtains[at] = curtain;
        }
    }
}
