// FlowingWater's volume water: the water near the camera as one body of fluid on the graphics card, moved as water
// moves, its mass conserved, authoritative for how it moves (the server keeps only what persists and what is far).
// A hybrid of particles and a grid (FLIP, Zhu and Bridson 2005, with APIC's care for the transfers kept simple): the
// particles carry the water (each a cube of water half a cell on a side: eight to a cell at rest) and move with it;
// each step their velocity is put on a staggered grid (a MAC grid, the velocity through each cell face), gravity is
// added, and a pressure is solved over the cells that hold water so that no water is made or lost in any cell (the
// divergence is driven to zero, with a little correction for cells with more or fewer particles than rest, which
// keeps the volume from drifting); the corrected grid velocity goes back to the particles (mostly as the change, so
// the particles' own motion is kept: FLIP; a little as the grid's own, so it stays stable: PIC), which are moved
// along it and kept out of the ground, what is built and the bodies in the water. Cells under the ground (the card's
// water's heights), in a built voxel (ParticleSolids) or in a body are solid: the water goes round them, pools over
// them, is held in by them, and breaks out where one is gone.
// A step:
//   ClearCells     each cell air, or solid where the ground, a voxel or a body is; no particles counted, no pressure,
//   ClearFaces     every face's sums empty,
//   Scatter        each particle's velocity onto the faces round it (a trilinear share each, summed in fixed point),
//                  counted into its cell, which holds water then,
//   Gather         each face's velocity from its sums; gravity; a solid face still, a source's face at its speed
//                  (scaled by Regulate),
//   Collect        the cells with water, in a list (the pressure is solved over them only),
//   Arguments      how many groups work through the list,
//   Divergence     each cell's net outflow, less the drift correction,
//   Relax          the pressure, one sweep of Gauss-Seidel over the cells of one colour (red, then black: so many
//                  sweeps),
//   Project        the faces' velocity less the pressure's slope across them,
//   Extend         the velocity carried a face out into the air, twice, so a particle at the surface reads it,
//   Move           each particle's velocity from the grid (FLIP with a little PIC), moved along the grid's velocity
//                  (two half steps), kept out of what is solid, let go out of the square's sides (the water beyond
//                  is the server's), taken by a drain within its reach,
//   Emit           a source's cells filled with particles going out of it as fast as its rate pushes them,
//   Regulate       each source's speed scaled by what it gave against its rate (its cells, cut to the grid and some
//                  against the ground, give less than its sphere would),
//   Compact        the particles still there, into the other buffer,
//   Settle         how many, and the drawing's arguments.
// Once, or for the edge band each frame: Seed, the server's water poured as particles where the cells hold none.
#pragma kernel ClearCells
#pragma kernel ClearFaces
#pragma kernel Scatter
#pragma kernel Gather
#pragma kernel Collect
#pragma kernel Arguments
#pragma kernel Divergence
#pragma kernel Relax
#pragma kernel Project
#pragma kernel Extend
#pragma kernel Move
#pragma kernel Emit
#pragma kernel Regulate
#pragma kernel Compact
#pragma kernel Settle
#pragma kernel Seed

#define THREADS 256
#define AIR 0
#define FLUID 1
#define SOLID 2
// A source's cell: water comes out of it at the source's speed (an inflow, as a moving wall is to the pressure).
#define EMIT 3
#define GONE 0xFFFFFFFFu
// Fixed point for the faces' sums: a thousandth of a millimetre a second over sixty-four particles' shares.
#define FIX 65536.0
// Particles a cell holds at rest (two a side).
#define REST 8
#define PER_SIDE 2
#define MOST_SOURCES 16
#define MOST_BODIES 32

struct Particle
{
    // The place; w: GONE once let go.
    float4 place;
    // xyz: unused (the drawing's layout); w: the share of the particle that is spray (in the air, few about it).
    float4 predicted;
    // The velocity; w: the particles in its cell, as a share of rest (the drawing's density).
    float4 velocity;
};

// A water source or drain (ParticleWater.Spout's layout kept: ring = centre and reach, flow = speed, rate, drain).
struct Spring
{
    float4 ring;
    float4 flow;
};

// A box in the water (ParticleWater.Body's layout), or a sphere.
struct Body
{
    float4 centre;
    float4 half;
    float4 axisX;
    float4 axisY;
};

// The game's graphics (Direct3D 12 under Unity) lets a kernel write eight buffers at most: each kernel binds what it
// writes as RW and what it only reads under an ...In name (the same buffer, read-only), and the faces' fields hold
// their three axes in one buffer each, one after the other.
RWStructuredBuffer<Particle> _Particles;
StructuredBuffer<Particle> _ParticlesIn;
RWStructuredBuffer<Particle> _Sorted;
// [0] particles there; [1] the compaction's slot counter; [2] the seed's and emitters' spawn counter.
RWStructuredBuffer<uint> _Alive;
StructuredBuffer<uint> _AliveIn;
RWStructuredBuffer<uint> _Args;
uint _Capacity;

// The grid: _Nx by _Ny by _Nz cells of _H metres, from the world point _Origin (its lowest, south-west corner).
int _Nx;
int _Ny;
int _Nz;
float _H;
float3 _Origin;
float _Dt;
float _Gravity;
float _Flip;
float _MaxSpeed;
// A drift correction: this share of a cell's excess or lack of particles is mended by the pressure each step.
float _Drift;
// Whether water may leave through the square's sides (the world beyond is the server's) or they are walls.
int _OpenSides;
uint _Seed;
int _Parity;

// Cells.
RWStructuredBuffer<int> _Type;
StructuredBuffer<int> _TypeIn;
RWStructuredBuffer<int> _Count;
StructuredBuffer<int> _CountIn;
RWStructuredBuffer<float> _Div;
StructuredBuffer<float> _DivIn;
RWStructuredBuffer<float> _P;
StructuredBuffer<float> _PIn;
AppendStructuredBuffer<uint> _ActiveOut;
StructuredBuffer<uint> _Active;
RWStructuredBuffer<uint> _ActiveArgs;
StructuredBuffer<uint> _ActiveArgsIn;
// Faces: the x, y and z faces' values one after the other, each set (_Nx + 1) by (_Ny + 1) by (_Nz + 1) (FaceAt).
RWStructuredBuffer<int> _Mom;
StructuredBuffer<int> _MomIn;
RWStructuredBuffer<int> _Wgt;
StructuredBuffer<int> _WgtIn;
RWStructuredBuffer<float> _Vel;
StructuredBuffer<float> _VelIn;
RWStructuredBuffer<float> _Vel0;
StructuredBuffer<float> _Vel0In;
RWStructuredBuffer<int> _Mask;
RWStructuredBuffer<int> _Mask2;

// The ground: the card's water's heights (SimGrid.Bed), _BedCells a side of _BedDx metres from _BedOrigin (world x, z).
Texture2D<float> _Bed;
int _BedCells;
float _BedDx;
float2 _BedOrigin;

// What is built (ParticleSolids): a byte a voxel, _SolidColumns a side of _VoxelSize metres from _SolidOrigin (world
// x, z), _SolidRows up from world height _SolidY0; the top bit is a solid voxel, the low six the voxel's faces a piece
// thinner than a voxel closes (east, west, up, down, north, south).
#define SOLID_BIT 128u
#define CLOSED_EAST 1u
#define CLOSED_WEST 2u
#define CLOSED_UP 4u
#define CLOSED_DOWN 8u
#define CLOSED_NORTH 16u
#define CLOSED_SOUTH 32u
int _SolidsOn;
Texture3D<float> _Solids;
int _SolidColumns;
int _SolidRows;
float _VoxelSize;
float2 _SolidOrigin;
float _SolidY0;

StructuredBuffer<Body> _Bodies;
uint _BodyCount;
StructuredBuffer<Spring> _Springs;
uint _SpringCount;
// What each drain has taken this step (particles), and may at most.
RWStructuredBuffer<uint> _Taken;
// What each source gave this step (particles), and the scale of its speed, kept from step to step (Regulate).
RWStructuredBuffer<uint> _Given;
StructuredBuffer<uint> _GivenIn;
RWStructuredBuffer<float> _Scale;
StructuredBuffer<float> _ScaleIn;
#define MOST_SCALE 2.0

// The server's water (SimGrid.Target): a texel a voxel column of the card's square, _PerVoxel cells of the bed's to
// its side, from the bed's origin: the water's resting top (x), whether the card draws it (y), its depth (z).
Texture2D<float4> _Target;
int _PerVoxel;
// Seeding: cells within this many cells of the square's sides only (0: all), and the share of a short column's lack
// made this call.
int _SeedBand;
float _SeedShare;
#define DRY_TOP -1000.0

// Where a block of still water is poured (the console, the preview): from _PourMin to _PourMax (world), on Seed with
// _PourOn.
int _PourOn;
float3 _PourMin;
float3 _PourMax;

float Random(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return word / 4294967296.0;
}

uint Alive()
{
    return min(_Alive[0], _Capacity);
}

uint AliveIn()
{
    return min(_AliveIn[0], _Capacity);
}

bool Gone(Particle p)
{
    return asuint(p.place.w) == GONE;
}

int CellIndex(int3 c)
{
    return ((c.z * _Ny) + c.y) * _Nx + c.x;
}

bool InGrid(int3 c)
{
    return c.x >= 0 && c.y >= 0 && c.z >= 0 && c.x < _Nx && c.y < _Ny && c.z < _Nz;
}

int FaceIndex(int3 f)
{
    return ((f.z * (_Ny + 1)) + f.y) * (_Nx + 1) + f.x;
}

int FaceCount()
{
    return (_Nx + 1) * (_Ny + 1) * (_Nz + 1);
}

// A face's place in a field: its axis's set, then its index.
int FaceAt(int3 f, int axis)
{
    return (axis * FaceCount()) + FaceIndex(f);
}

bool InFaces(int3 f)
{
    return f.x >= 0 && f.y >= 0 && f.z >= 0 && f.x <= _Nx && f.y <= _Ny && f.z <= _Nz;
}

int3 CellOf(float3 place)
{
    return (int3)floor((place - _Origin) / _H);
}

float3 CentreOf(int3 c)
{
    return _Origin + ((float3(c) + 0.5) * _H);
}

// The ground's height under a world point, between the bed's cells' centres (a slope is smooth), unless the cells
// round it step by more than STEP_UP (a wall, a cliff: then the cell's own, so the wall's height is not lent as a
// ramp to the floor beside it).
#define STEP_UP 1.0
float GroundAt(float2 xz)
{
    float2 at = ((xz - _BedOrigin) / _BedDx) - 0.5;
    int2 c = (int2)floor(at);
    float2 f = at - c;
    int2 c00 = clamp(c, 0, _BedCells - 1), c11 = clamp(c + 1, 0, _BedCells - 1);
    float b00 = _Bed[c00], b10 = _Bed[int2(c11.x, c00.y)], b01 = _Bed[int2(c00.x, c11.y)], b11 = _Bed[c11];
    float lowest = min(min(b00, b10), min(b01, b11)), highest = max(max(b00, b10), max(b01, b11));
    if (highest - lowest > STEP_UP)
    {
        return _Bed[clamp((int2)floor((xz - _BedOrigin) / _BedDx), 0, _BedCells - 1)];
    }

    return lerp(lerp(b00, b10, f.x), lerp(b01, b11, f.x), f.y);
}

// The voxel a world point is in, in the built voxels' own coordinates.
int3 VoxelOf(float3 place)
{
    return (int3)floor(float3(place.x - _SolidOrigin.x, place.y - _SolidY0, place.z - _SolidOrigin.y) / _VoxelSize);
}

// A voxel's byte: its solid bit and closed faces (0 out of the built voxels).
uint Built(int3 v)
{
    if (_SolidsOn == 0 || v.x < 0 || v.z < 0 || v.x >= _SolidColumns || v.z >= _SolidColumns || v.y < 0 || v.y >= _SolidRows)
    {
        return 0u;
    }

    return (uint)round(_Solids[v] * 255.0);
}

bool BuiltAt(float3 place)
{
    return (Built(VoxelOf(place)) & SOLID_BIT) != 0u;
}

// Whether a piece thinner than a voxel closes the way from the voxel of one point to the voxel of another along an
// axis (a face of either voxel between them).
bool ClosedBetween(float3 from, float3 to, int axis)
{
    if (_SolidsOn == 0)
    {
        return false;
    }

    int3 a = VoxelOf(from), b = VoxelOf(to);
    int fromCell = axis == 0 ? a.x : axis == 1 ? a.y : a.z;
    int toCell = axis == 0 ? b.x : axis == 1 ? b.y : b.z;
    if (fromCell == toCell)
    {
        return false;
    }

    bool forward = toCell > fromCell;
    uint fromBits = Built(a), toBits = Built(b);
    if (axis == 0)
    {
        return forward ? ((fromBits & CLOSED_EAST) | (toBits & CLOSED_WEST)) != 0u : ((fromBits & CLOSED_WEST) | (toBits & CLOSED_EAST)) != 0u;
    }

    if (axis == 1)
    {
        return forward ? ((fromBits & CLOSED_UP) | (toBits & CLOSED_DOWN)) != 0u : ((fromBits & CLOSED_DOWN) | (toBits & CLOSED_UP)) != 0u;
    }

    return forward ? ((fromBits & CLOSED_NORTH) | (toBits & CLOSED_SOUTH)) != 0u : ((fromBits & CLOSED_SOUTH) | (toBits & CLOSED_NORTH)) != 0u;
}

// Whether the grid face between two cells (along an axis) is closed by a thin piece.
bool ClosedFace(int3 a, int3 b, int axis)
{
    return ClosedBetween(CentreOf(a), CentreOf(b), axis);
}

bool InBody(float3 place)
{
    for (uint b = 0u; b < _BodyCount; b++)
    {
        Body body = _Bodies[b];
        float3 d = place - body.centre.xyz;
        if (body.centre.w > 1.5)
        {
            if (dot(d, d) < body.half.x * body.half.x)
            {
                return true;
            }

            continue;
        }

        float3 ax = body.axisX.xyz, ay = body.axisY.xyz, az = cross(ax, ay);
        float3 local = float3(dot(d, ax), dot(d, ay), dot(d, az));
        if (all(abs(local) < body.half.xyz))
        {
            return true;
        }
    }

    return false;
}

// Whether a world point is in something solid: the ground, a built voxel, a body.
bool SolidAt(float3 place)
{
    return place.y < GroundAt(place.xz) || BuiltAt(place) || InBody(place);
}

// The source whose reach a point is in, or -1.
int SourceAt(float3 place)
{
    for (uint s = 0u; s < _SpringCount; s++)
    {
        Spring spring = _Springs[s];
        if (spring.flow.z < 0.5 && distance(place, spring.ring.xyz) < spring.ring.w)
        {
            return (int)s;
        }
    }

    return -1;
}

// The velocity a source gives at a point: outward from its centre at its speed, scaled as Regulate found it.
float3 SourceVelocity(int s, float3 place)
{
    Spring spring = _Springs[s];
    float3 away = place - spring.ring.xyz;
    float d = length(away);
    return (d > 1e-4 ? away / d : float3(0.0, 1.0, 0.0)) * spring.flow.x * _ScaleIn[s];
}

// A cell's type, out of the grid: solid under and at closed sides, air above and at open sides.
int TypeAt(int3 c)
{
    if (c.y < 0)
    {
        return SOLID;
    }

    if (c.y >= _Ny)
    {
        return AIR;
    }

    if (c.x < 0 || c.z < 0 || c.x >= _Nx || c.z >= _Nz)
    {
        return _OpenSides != 0 ? AIR : SOLID;
    }

    return _TypeIn[CellIndex(c)];
}

float PressureAt(int3 c)
{
    return InGrid(c) && _TypeIn[CellIndex(c)] == FLUID ? _PIn[CellIndex(c)] : 0.0;
}

// A face's velocity, trilinear at a point of the grid's coordinates (the face's own: the point less the face's offset).
float SampleFace(StructuredBuffer<float> field, float3 g, int axis)
{
    g = clamp(g, 0.0, float3(_Nx, _Ny, _Nz));
    int3 b = clamp((int3)floor(g), 0, int3(_Nx - 1, _Ny - 1, _Nz - 1));
    float3 f = saturate(g - b);
    float v = 0.0;
    for (int k = 0; k < 2; k++)
    {
        for (int j = 0; j < 2; j++)
        {
            for (int i = 0; i < 2; i++)
            {
                float w = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y) * (k == 0 ? 1.0 - f.z : f.z);
                v += w * field[FaceAt(b + int3(i, j, k), axis)];
            }
        }
    }

    return v;
}

float3 Velocity(float3 place)
{
    float3 g = (place - _Origin) / _H;
    return float3(SampleFace(_VelIn, g - float3(0.0, 0.5, 0.5), 0), SampleFace(_VelIn, g - float3(0.5, 0.0, 0.5), 1), SampleFace(_VelIn, g - float3(0.5, 0.5, 0.0), 2));
}

float3 OldVelocity(float3 place)
{
    float3 g = (place - _Origin) / _H;
    return float3(SampleFace(_Vel0In, g - float3(0.0, 0.5, 0.5), 0), SampleFace(_Vel0In, g - float3(0.5, 0.0, 0.5), 1), SampleFace(_Vel0In, g - float3(0.5, 0.5, 0.0), 2));
}

// A particle's share of its velocity onto the eight faces round it, and their weights.
void ScatterFace(float3 g, float value, int axis)
{
    g = clamp(g, 0.0, float3(_Nx, _Ny, _Nz));
    int3 b = clamp((int3)floor(g), 0, int3(_Nx - 1, _Ny - 1, _Nz - 1));
    float3 f = saturate(g - b);
    for (int k = 0; k < 2; k++)
    {
        for (int j = 0; j < 2; j++)
        {
            for (int i = 0; i < 2; i++)
            {
                float w = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y) * (k == 0 ? 1.0 - f.z : f.z);
                if (w > 1e-5)
                {
                    int at = FaceAt(b + int3(i, j, k), axis);
                    InterlockedAdd(_Mom[at], (int)round(w * value * FIX));
                    InterlockedAdd(_Wgt[at], (int)round(w * FIX));
                }
            }
        }
    }
}

// A particle in something solid put out of it: the ground along its slope (so water on a bank slides down), a built
// voxel or a body out through the nearest face.
float3 Unsolid(float3 x, float3 before)
{
    float ground = GroundAt(x.xz);
    if (x.y < ground)
    {
        float e = 0.5 * _BedDx;
        float gx = GroundAt(x.xz + float2(e, 0.0)) - GroundAt(x.xz - float2(e, 0.0));
        float gz = GroundAt(x.xz + float2(0.0, e)) - GroundAt(x.xz - float2(0.0, e));
        float3 n = normalize(float3(-gx, 2.0 * e, -gz));
        float under = ground - x.y;
        x = n.y < 0.5 ? float3(x.x, ground, x.z) : x + (n * (under * n.y));
        x.y = max(x.y, GroundAt(x.xz));
    }

    if (BuiltAt(x))
    {
        float3 rel = float3(x.x - _SolidOrigin.x, x.y - _SolidY0, x.z - _SolidOrigin.y);
        int3 v = (int3)floor(rel / _VoxelSize);
        float3 lo = float3(v) * _VoxelSize, hi = lo + _VoxelSize;
        float3 sides[6] = { float3(-1, 0, 0), float3(1, 0, 0), float3(0, -1, 0), float3(0, 1, 0), float3(0, 0, -1), float3(0, 0, 1) };
        float pushes[6] = { rel.x - lo.x, hi.x - rel.x, rel.y - lo.y, hi.y - rel.y, rel.z - lo.z, hi.z - rel.z };
        float best = 1e9;
        float3 to = x;
        for (int s = 0; s < 6; s++)
        {
            float3 candidate = x + (sides[s] * (pushes[s] + (0.01 * _VoxelSize)));
            if (pushes[s] < best && !BuiltAt(candidate))
            {
                best = pushes[s];
                to = candidate;
            }
        }

        x = best < 1e9 ? to : before;
    }

    for (uint b = 0u; b < _BodyCount; b++)
    {
        Body body = _Bodies[b];
        float3 d = x - body.centre.xyz;
        if (body.centre.w > 1.5)
        {
            float dist = length(d);
            x = dist < body.half.x ? body.centre.xyz + ((dist > 1e-6 ? d / dist : float3(0.0, 1.0, 0.0)) * body.half.x) : x;
            continue;
        }

        float3 ax = body.axisX.xyz, ay = body.axisY.xyz, az = cross(ax, ay);
        float3 local = float3(dot(d, ax), dot(d, ay), dot(d, az));
        float3 ext = body.half.xyz;
        if (all(abs(local) < ext))
        {
            float3 pen = ext - abs(local);
            float3 side = float3(local.x < 0.0 ? -1.0 : 1.0, local.y < 0.0 ? -1.0 : 1.0, local.z < 0.0 ? -1.0 : 1.0);
            if (pen.x <= pen.y && pen.x <= pen.z)
            {
                local.x = side.x * ext.x;
            }
            else if (pen.y <= pen.z)
            {
                local.y = side.y * ext.y;
            }
            else
            {
                local.z = side.z * ext.z;
            }

            x = body.centre.xyz + (ax * local.x) + (ay * local.y) + (az * local.z);
        }
    }

    x.y = max(x.y, GroundAt(x.xz));
    return x;
}

// A particle made at a place, still or with a velocity; false when there is no room.
bool Spawn(float3 place, float3 velocity)
{
    uint at;
    InterlockedAdd(_Alive[2], 1u, at);
    at += _Alive[0];
    if (at >= _Capacity)
    {
        return false;
    }

    Particle p;
    p.place = float4(place, 1.0);
    p.predicted = float4(0.0, 0.0, 0.0, 0.0);
    p.velocity = float4(velocity, 1.0);
    _Particles[at] = p;
    return true;
}

[numthreads(THREADS, 1, 1)]
void ClearCells(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)(_Nx * _Ny * _Nz))
    {
        return;
    }

    int3 c = int3(i % _Nx, (i / _Nx) % _Ny, i / (_Nx * _Ny));
    float3 centre = CentreOf(c);
    _Type[i] = SolidAt(centre) ? SOLID : SourceAt(centre) >= 0 ? EMIT : AIR;
    _Count[i] = 0;
    _Div[i] = 0.0;
    // The pressure is kept from the last step: a pool at rest starts its relaxation nearly solved.
}

[numthreads(THREADS, 1, 1)]
void ClearFaces(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)((_Nx + 1) * (_Ny + 1) * (_Nz + 1)))
    {
        return;
    }

    for (int a = 0; a < 3; a++)
    {
        int at = (a * FaceCount()) + (int)i;
        _Mom[at] = 0;
        _Wgt[at] = 0;
        _Vel[at] = 0.0;
        _Vel0[at] = 0.0;
        _Mask[at] = 0;
    }
}

[numthreads(THREADS, 1, 1)]
void Scatter(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= AliveIn())
    {
        return;
    }

    Particle p = _ParticlesIn[i];
    if (Gone(p))
    {
        return;
    }

    int3 c = CellOf(p.place.xyz);
    if (!InGrid(c))
    {
        return;
    }

    float3 g = (p.place.xyz - _Origin) / _H;
    ScatterFace(g - float3(0.0, 0.5, 0.5), p.velocity.x, 0);
    ScatterFace(g - float3(0.5, 0.0, 0.5), p.velocity.y, 1);
    ScatterFace(g - float3(0.5, 0.5, 0.0), p.velocity.z, 2);
    int cell = CellIndex(c);
    InterlockedAdd(_Count[cell], 1);
    InterlockedMax(_Type[cell], FLUID);
}

// Whether a face is between two cells of which one is solid (it is still then), or a source's (it has the source's
// velocity then: Prescribed).
bool Held(int type)
{
    return type == SOLID || type == EMIT;
}

bool SolidFaceU(int3 f)
{
    return Held(TypeAt(f - int3(1, 0, 0))) || Held(TypeAt(f));
}

bool SolidFaceV(int3 f)
{
    return Held(TypeAt(f - int3(0, 1, 0))) || Held(TypeAt(f));
}

bool SolidFaceW(int3 f)
{
    return Held(TypeAt(f - int3(0, 0, 1))) || Held(TypeAt(f));
}

// The velocity a held face has along its axis: a source's where one of its cells is a source's (and neither solid),
// else still.
float Prescribed(int3 a, int3 b, float3 facePlace, int axis)
{
    int ta = TypeAt(a), tb = TypeAt(b);
    if (ta == SOLID || tb == SOLID)
    {
        return 0.0;
    }

    int s = SourceAt(facePlace);
    if (s < 0)
    {
        s = SourceAt(CentreOf(ta == EMIT ? a : b));
    }

    return s < 0 ? 0.0 : SourceVelocity(s, facePlace)[axis];
}

[numthreads(THREADS, 1, 1)]
void Gather(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)FaceCount())
    {
        return;
    }

    int3 f = int3(i % (_Nx + 1), (i / (_Nx + 1)) % (_Ny + 1), i / ((_Nx + 1) * (_Ny + 1)));
    int3 offsets[3] = { int3(1, 0, 0), int3(0, 1, 0), int3(0, 0, 1) };
    // The face's place: at the cell's corner along its axis, at the cell's middle across.
    float3 corners[3] = { float3(f.x, f.y + 0.5, f.z + 0.5), float3(f.x + 0.5, f.y, f.z + 0.5), float3(f.x + 0.5, f.y + 0.5, f.z) };
    bool within[3] = { f.y < _Ny && f.z < _Nz, f.x < _Nx && f.z < _Nz, f.x < _Nx && f.y < _Ny };
    for (int a = 0; a < 3; a++)
    {
        int at = (a * FaceCount()) + (int)i;
        float v = 0.0;
        bool valid = _WgtIn[at] > 0;
        if (valid)
        {
            v = (float)_MomIn[at] / (float)_WgtIn[at];
        }

        // The old velocity, for FLIP: before gravity and the pressure (both are the change the particles take).
        _Vel0[at] = v;
        _Vel[at] = a == 1 && valid ? v - (_Gravity * _Dt) : v;
        _Mask[at] = valid ? 1 : 0;
        if (within[a] && (Held(TypeAt(f - offsets[a])) || Held(TypeAt(f)) || ClosedFace(f - offsets[a], f, a)))
        {
            float held = ClosedFace(f - offsets[a], f, a) ? 0.0 : Prescribed(f - offsets[a], f, _Origin + (corners[a] * _H), a);
            _Vel[at] = held;
            _Vel0[at] = held;
            _Mask[at] = 1;
        }
    }
}

[numthreads(THREADS, 1, 1)]
void Collect(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i < (uint)(_Nx * _Ny * _Nz) && _TypeIn[i] == FLUID)
    {
        _ActiveOut.Append(i);
    }
}

[numthreads(1, 1, 1)]
void Arguments(uint3 id : SV_DispatchThreadID)
{
    // [3] holds the count the card copied in; the groups follow.
    _ActiveArgs[0] = (_ActiveArgs[3] + THREADS - 1) / THREADS;
    _ActiveArgs[1] = 1;
    _ActiveArgs[2] = 1;
}

[numthreads(THREADS, 1, 1)]
void Divergence(uint3 id : SV_DispatchThreadID)
{
    uint n = id.x;
    if (n >= _ActiveArgsIn[3])
    {
        return;
    }

    uint i = _Active[n];
    int3 c = int3(i % _Nx, (i / _Nx) % _Ny, i / (_Nx * _Ny));
    float div = (_VelIn[FaceAt(c + int3(1, 0, 0), 0)] - _VelIn[FaceAt(c, 0)] + _VelIn[FaceAt(c + int3(0, 1, 0), 1)] - _VelIn[FaceAt(c, 1)] + _VelIn[FaceAt(c + int3(0, 0, 1), 2)] - _VelIn[FaceAt(c, 2)]) / _H;
    // Too many particles in the cell: a little outflow asked for; too few, in a cell inside the water (one at the
    // surface is part empty by nature): a little inflow.
    int3 sides[6] = { int3(-1, 0, 0), int3(1, 0, 0), int3(0, -1, 0), int3(0, 1, 0), int3(0, 0, -1), int3(0, 0, 1) };
    bool inside = true;
    for (int s = 0; s < 6; s++)
    {
        inside = inside && TypeAt(c + sides[s]) != AIR;
    }

    float excess = clamp(((float)_CountIn[i] - REST) / REST, inside ? -1.0 : 0.0, 1.0);
    _Div[i] = div - (_Drift * excess / _Dt);
}

[numthreads(THREADS, 1, 1)]
void Relax(uint3 id : SV_DispatchThreadID)
{
    uint n = id.x;
    if (n >= _ActiveArgsIn[3])
    {
        return;
    }

    uint i = _Active[n];
    int3 c = int3(i % _Nx, (i / _Nx) % _Ny, i / (_Nx * _Ny));
    if (((c.x + c.y + c.z) & 1) != _Parity)
    {
        return;
    }

    int3 sides[6] = { int3(-1, 0, 0), int3(1, 0, 0), int3(0, -1, 0), int3(0, 1, 0), int3(0, 0, -1), int3(0, 0, 1) };
    float sum = 0.0;
    float open = 0.0;
    for (int s = 0; s < 6; s++)
    {
        int3 next = c + sides[s];
        int type = TypeAt(next);
        if (Held(type) || ClosedFace(c, next, s / 2))
        {
            continue;
        }

        open += 1.0;
        sum += type == FLUID ? _P[CellIndex(next)] : 0.0;
    }

    _P[i] = open > 0.0 ? (sum - (_DivIn[i] * _H * _H / _Dt)) / open : 0.0;
}

[numthreads(THREADS, 1, 1)]
void Project(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)FaceCount())
    {
        return;
    }

    int3 f = int3(i % (_Nx + 1), (i / (_Nx + 1)) % (_Ny + 1), i / ((_Nx + 1) * (_Ny + 1)));
    int3 offsets[3] = { int3(1, 0, 0), int3(0, 1, 0), int3(0, 0, 1) };
    bool within[3] = { f.y < _Ny && f.z < _Nz, f.x < _Nx && f.z < _Nz, f.x < _Nx && f.y < _Ny };
    for (int a = 0; a < 3; a++)
    {
        if (!within[a])
        {
            continue;
        }

        int3 back = f - offsets[a];
        int ta = TypeAt(back), tb = TypeAt(f);
        if (Held(ta) || Held(tb) || ClosedFace(back, f, a))
        {
            // Held: as Gather set it.
            continue;
        }

        if (ta == FLUID || tb == FLUID)
        {
            int at = (a * FaceCount()) + (int)i;
            _Vel[at] -= _Dt * (PressureAt(f) - PressureAt(back)) / _H;
            _Mask[at] = 1;
        }
    }
}

// One face's velocity, new and old alike (a particle at the surface takes the change between them: both must come
// from the same faces), from its valid neighbours along its axis's set, when it has none of its own.
void ExtendOne(int3 f, uint i, int axis)
{
    int at = (axis * FaceCount()) + (int)i;
    if (_Mask[at] != 0)
    {
        _Mask2[at] = 1;
        return;
    }

    int3 sides[6] = { int3(-1, 0, 0), int3(1, 0, 0), int3(0, -1, 0), int3(0, 1, 0), int3(0, 0, -1), int3(0, 0, 1) };
    float sum = 0.0;
    float sumOld = 0.0;
    float n = 0.0;
    for (int s = 0; s < 6; s++)
    {
        int3 next = f + sides[s];
        if (InFaces(next) && _Mask[FaceAt(next, axis)] != 0)
        {
            sum += _Vel[FaceAt(next, axis)];
            sumOld += _Vel0[FaceAt(next, axis)];
            n += 1.0;
        }
    }

    if (n > 0.0)
    {
        _Vel[at] = sum / n;
        _Vel0[at] = sumOld / n;
        _Mask2[at] = 1;
    }
    else
    {
        _Mask2[at] = 0;
    }
}

[numthreads(THREADS, 1, 1)]
void Extend(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)FaceCount())
    {
        return;
    }

    int3 f = int3(i % (_Nx + 1), (i / (_Nx + 1)) % (_Ny + 1), i / ((_Nx + 1) * (_Ny + 1)));
    ExtendOne(f, i, 0);
    ExtendOne(f, i, 1);
    ExtendOne(f, i, 2);
}

[numthreads(THREADS, 1, 1)]
void Move(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= AliveIn())
    {
        return;
    }

    Particle p = _Particles[i];
    if (Gone(p))
    {
        return;
    }

    float3 x = p.place.xyz;
    float3 grid = Velocity(x);
    float3 flip = p.velocity.xyz + (grid - OldVelocity(x));
    float3 v = lerp(grid, flip, _Flip);
    float speed = length(v);
    v = speed > _MaxSpeed ? v * (_MaxSpeed / speed) : v;

    // Moved along the grid's velocity, two half steps; not through a face a thin piece closes (held at the face).
    float3 mid = x + (0.5 * _Dt * grid);
    float3 to = x + (_Dt * Velocity(mid));
    to = Unsolid(to, x);
    if (_SolidsOn != 0)
    {
        int3 was = VoxelOf(x);
        float3 lo = float3(_SolidOrigin.x, _SolidY0, _SolidOrigin.y) + (float3(was) * _VoxelSize), hi = lo + _VoxelSize;
        float gap = 0.02 * _VoxelSize;
        if (ClosedBetween(x, to, 0))
        {
            to.x = clamp(to.x, lo.x + gap, hi.x - gap);
        }

        if (ClosedBetween(x, to, 1))
        {
            to.y = clamp(to.y, lo.y + gap, hi.y - gap);
        }

        if (ClosedBetween(x, to, 2))
        {
            to.z = clamp(to.z, lo.z + gap, hi.z - gap);
        }
    }

    // Out of the square's sides: the server's water now; out of the top: held.
    float3 lo = _Origin, hi = _Origin + (float3(_Nx, _Ny, _Nz) * _H);
    float eps = 0.01 * _H;
    if (to.x < lo.x || to.z < lo.z || to.x >= hi.x || to.z >= hi.z)
    {
        if (_OpenSides != 0)
        {
            p.place.w = asfloat(GONE);
            _Particles[i] = p;
            return;
        }

        to.x = clamp(to.x, lo.x + eps, hi.x - eps);
        to.z = clamp(to.z, lo.z + eps, hi.z - eps);
    }

    to.y = min(to.y, hi.y - eps);
    if (to.y < lo.y)
    {
        p.place.w = asfloat(GONE);
        _Particles[i] = p;
        return;
    }

    // Taken by a drain within reach, up to what it takes this step.
    for (uint s = 0u; s < _SpringCount; s++)
    {
        Spring spring = _Springs[s];
        if (spring.flow.z > 0.5 && distance(to, spring.ring.xyz) < spring.ring.w)
        {
            uint k;
            InterlockedAdd(_Taken[s], 1u, k);
            if (k < (uint)spring.flow.w)
            {
                p.place.w = asfloat(GONE);
                _Particles[i] = p;
                return;
            }
        }
    }

    int3 c = CellOf(to);
    int count = InGrid(c) ? _CountIn[CellIndex(c)] : 0;
    bool clear = to.y > GroundAt(to.xz) + _H;
    p.place.xyz = to;
    p.velocity = float4(v, (float)count / REST);
    p.predicted.w = clear ? saturate(1.0 - ((float)count / 3.0)) : 0.0;
    _Particles[i] = p;
}

// A source's cells (within its reach, not solid) kept at rest's count, the new particles going out of it at its
// speed: the pressure spreads what the cells cannot hold; a drain's reach is cleared by Move.
[numthreads(THREADS, 1, 1)]
void Emit(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)(_Nx * _Ny * _Nz) || _TypeIn[i] != EMIT)
    {
        return;
    }

    int3 c = int3(i % _Nx, (i / _Nx) % _Ny, i / (_Nx * _Ny));
    float3 centre = CentreOf(c);
    int s = SourceAt(centre);
    if (s < 0)
    {
        return;
    }

    uint state = (i * 2654435761u) ^ (_Seed * 40503u) ^ 0x9E3779B9u;
    int lack = REST - _CountIn[i];
    for (int k = 0; k < lack; k++)
    {
        float3 place = centre + ((float3(Random(state), Random(state), Random(state)) - 0.5) * _H);
        if (SolidAt(place))
        {
            continue;
        }

        if (!Spawn(place, SourceVelocity(s, place)))
        {
            return;
        }

        InterlockedAdd(_Given[(uint)s], 1u);
    }
}

// Each source's speed scaled toward giving its rate: a fifth of the way each step, twice its speed at most (a source
// whose sphere is mostly in the ground gives what it can).
[numthreads(1, 1, 1)]
void Regulate(uint3 id : SV_DispatchThreadID)
{
    for (uint s = 0u; s < _SpringCount; s++)
    {
        Spring spring = _Springs[s];
        if (spring.flow.z > 0.5)
        {
            continue;
        }

        // Particles a step: the rate's water in particles of a cell's water over REST.
        float want = spring.flow.y * _Dt * REST / (_H * _H * _H);
        float given = (float)_GivenIn[s];
        float scale = _Scale[s] <= 0.0 ? 1.0 : _Scale[s];
        scale = given > 0.5 ? scale * lerp(1.0, want / given, 0.2) : scale * 1.05;
        _Scale[s] = clamp(scale, 0.25, MOST_SCALE);
    }
}

[numthreads(THREADS, 1, 1)]
void Compact(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= min(_Alive[0] + _Alive[2], _Capacity))
    {
        return;
    }

    Particle p = _ParticlesIn[i];
    if (Gone(p))
    {
        return;
    }

    uint slot;
    InterlockedAdd(_Alive[1], 1u, slot);
    _Sorted[slot] = p;
}

[numthreads(1, 1, 1)]
void Settle(uint3 id : SV_DispatchThreadID)
{
    uint n = min(_Alive[1], _Capacity);
    _Alive[0] = n;
    _Alive[1] = 0u;
    _Alive[2] = 0u;
    _Args[0] = n * 6u;
    _Args[1] = 1u;
    _Args[2] = 0u;
    _Args[3] = 0u;
}

// The server's water poured as particles: in each cell of a column the server has water in, between the ground and
// the water's top, that holds none (a share of what it lacks: a column filling), still. Within _SeedBand cells of
// the square's sides only, when that is set (the edge, each frame: water coming in from beyond). Or a block of still
// water (_PourOn), wherever the cells hold none.
[numthreads(THREADS, 1, 1)]
void Seed(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= (uint)(_Nx * _Ny * _Nz) || _TypeIn[i] == SOLID || _CountIn[i] >= REST)
    {
        return;
    }

    int3 c = int3(i % _Nx, (i / _Nx) % _Ny, i / (_Nx * _Ny));
    if (_SeedBand > 0 && c.x >= _SeedBand && c.z >= _SeedBand && c.x < _Nx - _SeedBand && c.z < _Nz - _SeedBand)
    {
        return;
    }

    float3 centre = CentreOf(c);
    float3 lo = centre - (0.5 * _H), hi = centre + (0.5 * _H);
    float top;
    if (_PourOn != 0)
    {
        if (any(hi < _PourMin) || any(lo > _PourMax))
        {
            return;
        }

        top = _PourMax.y;
        lo = max(lo, _PourMin);
        hi = min(hi, _PourMax);
    }
    else
    {
        int2 column = (int2)floor((centre.xz - _BedOrigin) / (_BedDx * _PerVoxel));
        float4 target = _Target[column];
        if (target.y < 0.5 || target.x <= DRY_TOP || target.z <= 0.0)
        {
            return;
        }

        top = target.x;
    }

    if (lo.y >= top)
    {
        return;
    }

    uint state = (i * 9781u) ^ (_Seed * 6271u) ^ 0x5bd1e995u;
    int lack = REST - _CountIn[i];
    int n = (int)floor((lack * _SeedShare) + Random(state));
    for (int k = 0; k < n; k++)
    {
        float3 place = lerp(lo, hi, float3(Random(state), Random(state), Random(state)));
        if (place.y < top && !SolidAt(place) && !Spawn(place, 0.0))
        {
            return;
        }
    }
}
